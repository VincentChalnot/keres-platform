{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page container-page--narrow">
            <div class="card">
                <h1 class="page-title">{{ 'login.title'|trans }}</h1>
                <p class="page-subtitle">{{ 'login.subtitle'|trans }}</p>

                <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="btn btn--light btn--block mb-3">
                    <span class="icon">
                        <i class="fa-brands fa-google" aria-hidden="true"></i>
                    </span>
                    <span>{{ 'login.google'|trans }}</span>
                </a>
                <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="btn btn--light btn--block">
                    <span class="icon">
                        <i class="fa-brands fa-discord" aria-hidden="true"></i>
                    </span>
                    <span>{{ 'login.discord'|trans }}</span>
                </a>
{#                <a href="{{ path('oidc_login', {provider: 'facebook'}) }}" class="btn btn--light btn--block mt-3">
                    <span class="icon">
                        <i class="fa-brands fa-facebook" aria-hidden="true"></i>
                    </span>
                    <span>Login with Facebook</span>
                </a>#}

                <hr class="my-6 border-line">
                <p class="page-subtitle !mb-4">{{ 'login.email_subtitle'|trans }}</p>
                {% if error %}
                    <div class="alert alert--danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <form method="post" action="{{ path('login_check') }}">
                    <div class="field">
                        <label class="label" for="login-username">{{ 'login.email'|trans }}</label>
                        <input type="email" id="login-username" name="_username" class="input" value="{{ last_username }}" required autocapitalize="off" autocorrect="off">
                    </div>
                    <div class="field">
                        <label class="label" for="login-password">{{ 'login.password'|trans }}</label>
                        <input type="password" id="login-password" name="_password" class="input" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <button type="submit" class="btn btn--primary">{{ 'login.submit'|trans }}</button>
                        <a href="{{ path('lost_password') }}">{{ 'login.forgot_password'|trans }}</a>
                    </div>
                </form>
                <p class="mb-0 mt-4">
                    {{ 'login.no_account'|trans({url: path('register')|e('html_attr')})|raw }}
                </p>

                {% if app.environment == 'dev' %}
                    <hr class="my-6 border-line">
                    <p class="page-subtitle !mb-4">{{ 'login.dev_title'|trans }}</p>
                    <form method="get" action="{{ path('dev_login') }}" class="input-group">
                        <input type="email" name="email" class="input" placeholder="{{ 'login.dev_placeholder'|trans }}" required>
                        <button type="submit" class="btn btn--outline">{{ 'login.dev_submit'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
