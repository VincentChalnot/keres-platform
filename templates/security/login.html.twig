{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">{{ 'login.title'|trans }}</h3>
                        <p class="subtitle">{{ 'login.subtitle'|trans }}</p>

                        <div class="buttons is-centered">
                            <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-google" aria-hidden="true"></i>
                                </span>
                                <span>{{ 'login.google'|trans }}</span>
                            </a>
                            <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-discord" aria-hidden="true"></i>
                                </span>
                                <span>{{ 'login.discord'|trans }}</span>
                            </a>
{#                            <a href="{{ path('oidc_login', {provider: 'facebook'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-facebook" aria-hidden="true"></i>
                                </span>
                                <span>Login with Facebook</span>
                            </a>#}
                        </div>

                        <hr>
                        <p class="subtitle">{{ 'login.email_subtitle'|trans }}</p>
                        {% if error %}
                            <div class="notification is-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <form method="post" action="{{ path('login_check') }}">
                            <div class="field">
                                <label class="label">{{ 'login.email'|trans }}</label>
                                <div class="control">
                                    <input type="email" name="_username" class="input" value="{{ last_username }}" required autocapitalize="off" autocorrect="off">
                                </div>
                            </div>
                            <div class="field">
                                <label class="label">{{ 'login.password'|trans }}</label>
                                <div class="control">
                                    <input type="password" name="_password" class="input" required>
                                </div>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            <div class="field is-grouped is-grouped-multiline is-justify-content-space-between">
                                <div class="control">
                                    <button type="submit" class="button is-primary is-rounded">{{ 'login.submit'|trans }}</button>
                                </div>
                                <div class="control">
                                    <a href="{{ path('lost_password') }}">{{ 'login.forgot_password'|trans }}</a>
                                </div>
                            </div>
                        </form>
                        <p class="mt-3">
                            {{ 'login.no_account'|trans({url: path('register')|e('html_attr')})|raw }}
                        </p>

                        {% if app.environment == 'dev' %}
                            <hr>
                            <p class="subtitle">{{ 'login.dev_title'|trans }}</p>
                            <form method="get" action="{{ path('dev_login') }}" class="field has-addons">
                                <div class="control is-expanded">
                                    <input type="email" name="email" class="input" placeholder="{{ 'login.dev_placeholder'|trans }}" required>
                                </div>
                                <div class="control">
                                    <button type="submit" class="button is-rounded is-light">{{ 'login.dev_submit'|trans }}</button>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
