{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">Login</h3>
                        <p class="subtitle">Choose your login provider</p>

                        <div class="buttons is-centered">
                            <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-google" aria-hidden="true"></i>
                                </span>
                                <span>Login with Google</span>
                            </a>
                            <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-discord" aria-hidden="true"></i>
                                </span>
                                <span>Login with Discord</span>
                            </a>
{#                            <a href="{{ path('oidc_login', {provider: 'facebook'}) }}" class="button is-rounded is-light is-fullwidth mb-3">
                                <span class="icon">
                                    <i class="fa-brands fa-facebook" aria-hidden="true"></i>
                                </span>
                                <span>Login with Facebook</span>
                            </a>#}
                        </div>

                        <hr>
                        <p class="subtitle">Login with email &amp; password</p>
                        {% if error %}
                            <div class="notification is-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <form method="post" action="{{ path('login_check') }}">
                            <div class="field">
                                <label class="label">Email</label>
                                <div class="control">
                                    <input type="email" name="_username" class="input" value="{{ last_username }}" required autocapitalize="off" autocorrect="off">
                                </div>
                            </div>
                            <div class="field">
                                <label class="label">Password</label>
                                <div class="control">
                                    <input type="password" name="_password" class="input" required>
                                </div>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            <div class="field is-grouped is-grouped-multiline is-justify-content-space-between">
                                <div class="control">
                                    <button type="submit" class="button is-primary is-rounded">Login</button>
                                </div>
                                <div class="control">
                                    <a href="{{ path('lost_password') }}">Forgot your password?</a>
                                </div>
                            </div>
                        </form>
                        <p class="mt-3">
                            No account yet? <a href="{{ path('register') }}">Create one</a>.
                        </p>

                        {% if app.environment == 'dev' %}
                            <hr>
                            <p class="subtitle">Dev login (bypasses OIDC)</p>
                            <form method="get" action="{{ path('dev_login') }}" class="field has-addons">
                                <div class="control is-expanded">
                                    <input type="email" name="email" class="input" placeholder="someone@example.com" required>
                                </div>
                                <div class="control">
                                    <button type="submit" class="button is-rounded is-light">Login as</button>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
