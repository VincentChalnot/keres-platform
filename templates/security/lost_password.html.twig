{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'lost_password.title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">{{ 'lost_password.title'|trans }}</h3>
                        <p class="subtitle">{{ 'lost_password.subtitle'|trans }}</p>

                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                        {{ form_end(form) }}

                        <p class="mt-3">
                            <a href="{{ path('login') }}">{{ 'lost_password.back_to_login'|trans }}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
