{% extends 'base.html.twig' %}

{% block title %}Forgot your password?{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">Forgot your password?</h3>
                        <p class="subtitle">We'll email you a link to reset it.</p>

                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                        {{ form_end(form) }}

                        <p class="mt-3">
                            <a href="{{ path('login') }}">Back to login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
