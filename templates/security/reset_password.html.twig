{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">Reset your password</h3>
                        <p class="subtitle">Choose a new password for {{ user.email }}</p>

                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                        {{ form_end(form) }}

                        <p class="mt-3">
                            <a href="{{ path('login') }}">Back to login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
