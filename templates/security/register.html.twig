{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page container-page--narrow">
            <div class="card">
                <h1 class="page-title">{{ 'register.title'|trans }}</h1>
                <p class="page-subtitle">{{ 'register.subtitle'|trans }}</p>

                {{ form_start(form) }}
                    {{ form_widget(form) }}
                {{ form_end(form) }}

                <p class="mt-4 text-sm text-muted">
                    {{ 'register.trust_notice'|trans({url: (static_site_url ~ '/trust')|e('html_attr')})|raw }}
                </p>

                <p class="mb-0 mt-4">
                    {{ 'register.have_account'|trans({url: path('login')|e('html_attr')})|raw }}
                </p>
            </div>
        </div>
    </section>
{% endblock %}
