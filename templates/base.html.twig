{% trans_default_domain 'navigation' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    {% block head %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {# The whole UI is dark: tells browsers' forced dark modes (Brave, Samsung Internet...) not to invert it again. #}
        <meta name="color-scheme" content="dark">
        <title>Keres - {% block title %}{{ 'meta.default_title'|trans }}{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('/favicon-96x96.png') }}" sizes="96x96"/>
        <link rel="icon" type="image/svg+xml" href="{{ asset('/logo.svg') }}"/>
        <link rel="shortcut icon" href="{{ asset('/favicon.ico') }}"/>
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/apple-touch-icon.png') }}"/>
        <meta name="apple-mobile-web-app-title" content="Keres"/>
        <link rel="manifest" href="{{ asset('/site.webmanifest') }}"/>
        <meta name="mercure-cookie-ttl" content="{{ mercure_cookie_ttl }}">
        {# Front-end strings (translations domains frontend*) for assets/typescript/src/i18n #}
        <script type="application/json" id="app-i18n">{{ frontend_i18n() }}</script>
        {% if 'dev' == vite_mode() %}
            {# Dev only: Vite injects the CSS with JavaScript, so the page would paint unstyled first. A direct, render-blocking
               request to the dev server (it answers a <link> with plain CSS) avoids that flash. Same host convention as vite.config.js. #}
            <link rel="stylesheet" href="https://vite.{{ app.request.host }}/build/assets/design-system.css">
        {% endif %}
        {{ vite_entry_link_tags('app') }}
        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}
    {% endblock %}
</head>
<body>
{% block topnav %}
    <nav class="navbar" role="navigation" aria-label="{{ 'nav.main_label'|trans }}">
        <div class="container-page navbar__inner">
            <div class="navbar__brand">
                <a class="navbar__logo" href="{{ static_site_url }}/" aria-label="{{ 'brand.home_label'|trans }}">
                    <img src="{{ asset('logo.svg') }}" alt="" width="32" height="32" aria-hidden="true">
                    <span class="navbar__logo-text">Keres</span>
                </a>
                <button type="button" class="navbar__burger" id="navbar-burger" aria-label="{{ 'nav.toggle_menu'|trans }}" aria-expanded="false" aria-controls="navbar-menu">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div class="navbar__menu" id="navbar-menu">
                <div class="navbar__start">
                    {% block nav_extra %}
                        {% if app.user %}
                            <a href="{{ path('dashboard') }}" class="navbar__link">
                                <span class="navbar__icon is-mobile-only"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
                                <span>{{ 'nav.dashboard'|trans }}</span>
                            </a>
                            <a href="{{ path('friends') }}" class="navbar__link">
                                <span class="navbar__icon is-mobile-only"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
                                <span>{{ 'nav.friends'|trans }}</span>
                            </a>
                        {% endif %}
                    {% endblock %}
                    <a href="{{ static_site_url }}/rules" class="navbar__link">
                        <span class="navbar__icon is-mobile-only"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
                        <span>{{ 'nav.rules'|trans }}</span>
                    </a>
                    {% if tutorial_available() %}
                        <a href="{{ path('tutorial') }}" class="navbar__link">
                            <span class="navbar__icon is-mobile-only"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
                            <span>{{ 'nav.tutorial'|trans }}</span>
                        </a>
                    {% endif %}
                </div>
                <div class="navbar__end">
                    <a href="{{ path('lobby') }}" class="btn btn--primary btn--sm navbar__link navbar__play">
                        <span class="navbar__icon is-mobile-only">{{ include('_icon_king.html.twig') }}</span>
                        <span>{{ 'nav.play'|trans }}</span>
                    </a>
                    {% if app.user %}
                        {% set unread = unread_notification_count() %}
                        <div class="bell" id="notification-bell"
                             data-user-uuid="{{ app.user.id }}"
                             data-mercure-url="{{ mercure() }}">
                            <button type="button" class="bell__toggle navbar__link" id="notification-bell-toggle"
                                    aria-haspopup="true" aria-expanded="false" aria-controls="notification-bell-panel"
                                    aria-label="{{ 'notifications.bell_label'|trans({count: unread}) }}" title="{{ 'notifications.title'|trans }}">
                                <span class="navbar__icon relative">
                                    <i class="fa-solid fa-bell" aria-hidden="true"></i>
                                    <span class="bell__badge" id="notification-bell-badge" {% if unread == 0 %}hidden{% endif %}>{{ unread >= 100 ? '99+' : unread }}</span>
                                </span>
                                <span class="is-mobile-only" aria-hidden="true">{{ 'notifications.title'|trans }}</span>
                            </button>
                            <div class="bell__panel" id="notification-bell-panel" hidden>
                                <div class="bell__header">
                                    <strong>{{ 'notifications.title'|trans }}</strong>
                                    <button type="button" class="btn btn--text btn--sm" id="notification-bell-read-all">{{ 'notifications.mark_all_read'|trans }}</button>
                                </div>
                                <ul class="bell__list" id="notification-bell-list">
                                    <li class="notif-empty">{{ 'notifications.loading'|trans }}</li>
                                </ul>
                                <a href="{{ path('notifications') }}" class="bell__footer">{{ 'notifications.see_all'|trans }}</a>
                            </div>
                        </div>
                        <a href="{{ path('settings') }}" class="navbar__link" aria-label="{{ 'nav.settings'|trans }}" title="{{ 'nav.settings'|trans }}">
                            <span class="navbar__icon"><i class="fa-solid fa-gear" aria-hidden="true"></i></span>
                            <span class="is-mobile-only" aria-hidden="true">{{ 'nav.settings'|trans }}</span>
                        </a>
                        <a href="{{ path('profile', {username: app.user.username}) }}" class="navbar__link navbar__user">
                            {% if app.user.avatarUrl %}
                                <img src="{{ app.user.avatarUrl }}" alt="" class="navbar__avatar">
                            {% else %}
                                <span class="navbar__icon"><i class="fa-solid fa-circle-user" aria-hidden="true"></i></span>
                            {% endif %}
                            <span>{{ app.user.displayName ?? app.user.username }}</span>
                        </a>
                        <a href="{{ path('logout') }}" class="btn btn--outline btn--sm navbar__link navbar__ghost">
                            <span class="navbar__icon"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></span>
                            <span>{{ 'nav.logout'|trans }}</span>
                        </a>
                    {% else %}
                        {{ include('_language_switcher.html.twig', {variant: 'navbar'}) }}
                        <a href="{{ path('login') }}" class="btn btn--outline btn--sm navbar__link navbar__ghost">
                            <span class="navbar__icon"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i></span>
                            <span>{{ 'nav.login'|trans }}</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>
{% endblock %}
{% block flash_messages %}
    {# Flash types raised by the app: success, error. Anything else falls back to the neutral info alert. #}
    {% set alert_kinds = {success: 'success', error: 'danger', danger: 'danger', warning: 'warning', info: 'info'} %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            {% set kind = alert_kinds[type] ?? 'info' %}
            <div class="container-page mt-4">
                <div class="alert alert--{{ kind }}" role="{{ 'danger' == kind ? 'alert' : 'status' }}">
                    {{ message }}
                </div>
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}
{% block body %}{% endblock %}
{% block modals %}
    <div class="modal" id="app-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="app-confirm-modal-title">
        <div class="modal__backdrop"></div>
        <div class="modal__card">
            <header class="modal__head">
                <p class="modal__title" id="app-confirm-modal-title">{{ 'confirm_modal.title'|trans }}</p>
            </header>
            <section class="modal__body" id="app-confirm-modal-body"></section>
            <footer class="modal__foot">
                <button type="button" class="btn btn--primary" id="app-confirm-modal-ok">{{ 'confirm_modal.confirm'|trans }}</button>
                <button type="button" class="btn btn--outline" id="app-confirm-modal-cancel">{{ 'confirm_modal.cancel'|trans }}</button>
            </footer>
        </div>
    </div>
{% endblock %}
{% block footer %}
<footer class="footer">
    <p class="mb-2">&copy; Keres 2025-2026 <span class="footer__meta">{{ app_version }}</span></p>
    {{ include('_language_switcher.html.twig', {variant: 'footer'}) }}
    <nav>
        <a href="{{ static_site_url }}/legal-notice">{{ 'footer.legal_notice'|trans }}</a>
        <a href="{{ static_site_url }}/terms-of-use">{{ 'footer.terms'|trans }}</a>
        <a href="{{ static_site_url }}/privacy-policy">{{ 'footer.privacy'|trans }}</a>
        <a href="{{ static_site_url }}/contact">{{ 'footer.contact'|trans }}</a>
        {% if app.user %}
            <a href="{{ path('feedback') }}">{{ 'footer.feedback'|trans }}</a>
        {% endif %}
    </nav>
</footer>
{% endblock %}
{% block end_javascripts %}{% endblock %}
</body>
</html>
