{# Design-system replacement for Sidus\DataGridBundle's bundled "bootstrap4" form theme.
   Kept under the original "bootstrap4.html.twig" filename on purpose: it's the template
   logical name referenced by config/packages/twig.yaml and by SidusDataGridBundle's own
   Configuration (default_datagrid_template/form theme chaining) — Symfony's bundle template
   override mechanism (templates/bundles/<Bundle>/...) resolves this file instead of the
   vendored one, with zero changes required in the bundle itself. #}
{% use '@SidusFilter/Form/fields.html.twig' %}

{% block sidus_combo_filter_widget %}
    <div class="input-group">
        {{ form_widget(form.input) }}
        {{ form_widget(form.option) }}
    </div>
{% endblock %}

{% block sidus_order_button_widget %}
    {% apply spaceless %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' btn btn--text w-full justify-start font-semibold')|trim}) %}
        <button {{ block('widget_container_attributes') }} name="{{ form.vars.full_name }}">
            {{ arrow|raw }}&nbsp;{{ label|raw }}
        </button>
    {% endapply %}
{% endblock %}

{% block sidus_date_range_widget %}
    {% apply spaceless %}
        <div {{ block('widget_container_attributes') }}>
            {% if form.parent is empty %}
                {{ block('global_form_errors') }}
            {% endif %}
            <div class="input-group">
                {{ form_widget(form.startDate, {attr: {class: '!px-1.5 text-xs sm:!px-2 sm:text-sm min-w-0'}}) }}
                <span class="btn btn--static min-w-0">{{ 'sidus.filter.date_range.to'|trans }}</span>
                {{ form_widget(form.endDate, {attr: {class: '!px-1.5 text-xs sm:!px-2 sm:text-sm min-w-0'}}) }}
            </div>
            {{ form_errors(form.startDate) }}
            {{ form_errors(form.endDate) }}
            {{ form_rest(form) }}
        </div>
    {% endapply %}
{% endblock %}

{% block sidus_link_widget %}
    {% apply spaceless %}
        {% if label is empty %}
            {%- if label_format is defined and label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {% endif %}
        {% if not uri %}
            {% set uri = path(route, route_parameters) %}
        {% endif %}
        {# The form type defaults attr.class to bootstrap "btn btn-default btn-light";
           translate the well-known bootstrap button classes it may carry to the design system's. #}
        {% set bootstrap_to_ds = {
            'btn-default': 'btn--outline',
            'btn-light': 'btn--outline',
            'btn-primary': 'btn--primary',
            'btn-danger': 'btn--danger',
            'btn-info': 'btn--info',
            'btn-success': 'btn--secondary',
            'btn-secondary': 'btn--outline',
        } %}
        {% set classes = ['btn'] %}
        {% for token in attr.class|default('btn-light')|split(' ') %}
            {% if token and token != 'btn' %}
                {% set classes = classes|merge([bootstrap_to_ds[token] ?? token]) %}
            {% endif %}
        {% endfor %}
        {% set attr = attr|merge({class: classes|join(' ')}) %}
        <a href="{{ uri }}" {{ block('button_attributes') }}>
            {{ label|trans({}, translation_domain)|raw }}
        </a>
    {% endapply %}
{% endblock %}

{% block sidus_link_row %}
    {{ block('sidus_link_widget') }}
{% endblock %}
