{# Design-system replacement for Sidus\DataGridBundle's bundled "bootstrap4" datagrid
   template. Kept under the original filename on purpose (see Form/bootstrap4.html.twig
   override in this same bundle-override directory for the full rationale). #}
{# @var datagrid \Sidus\DataGridBundle\Model\DataGrid #}
{% block datagrid %}
    {# @var pager \Pagerfanta\Pagerfanta #}
    {% set pager = datagrid.queryHandler.pager %}
    {% set form = datagrid.formView %}

    {% block form_start %}
        {% if datagrid.formTheme %}
            {% form_theme form datagrid.formTheme %}
        {% endif %}
        {{ form_start(form) }}
        <div class="card">
    {% endblock %}

    {% block filters %}
        {% if form.filters|length > 0 %}
            {% set num_columns = num_columns|default(3) %}
            {% set grid_columns = {1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 2xl:grid-cols-3', 4: 'md:grid-cols-2 2xl:grid-cols-4'} %}
            <div class="grid grid-cols-1 gap-x-4 {{ grid_columns[num_columns]|default('md:grid-cols-2 2xl:grid-cols-3') }}">
                {% for column in get_filter_columns(form.filters, num_columns) %}
                    <div>
                        {% for cell in column %}
                            {{ form_row(cell) }}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}

    {% block action_menu %}
        <div class="toolbar">
            <div class="toolbar__group">
                {% block datagrid_count %}
                    <span class="tag tag--white tag--lg">
                        {{ 'sidus.datagrid.results.label'|trans({
                            '%length%': pager.currentPageResults|length,
                            '%first%': pager.currentPageOffsetStart,
                            '%last%': pager.currentPageOffsetEnd,
                            '%count%': pager.count,
                        }) }}
                    </span>
                {% endblock %}
                {% block datagrid_actions %}
                    <div class="btn-group">
                        {% for action in datagrid.formView.actions %}
                            {{ form_widget(action, {attr: {class: 'btn--sm'}}) }}
                        {% endfor %}
                    </div>
                {% endblock %}
            </div>
            <div class="toolbar__group">
                {% block filters_actions %}
                    <div class="btn-group">
                        {% if datagrid.formView.filterResetButton is defined %}
                            {{ form_widget(datagrid.formView.filterResetButton, {attr: {class: 'btn--outline btn--sm'}}) }}
                        {% endif %}
                        {% if datagrid.formView.filterSubmitButton is defined %}
                            {{ form_widget(datagrid.formView.filterSubmitButton, {attr: {class: 'btn--primary btn--sm'}}) }}
                        {% endif %}
                    </div>
                {% endblock %}
            </div>
        </div>
        {% block pagination %}
            {% include '@SidusDataGrid/Pager/pager.html.twig' %}
        {% endblock %}
    {% endblock %}

    {% block datagrid_table %}
        {% set sort = datagrid.formView.sortable %}
        <div class="table-wrap">
            <table{{ attributes(datagrid.attributes, {class: 'table table--hover table--compact whitespace-nowrap'}) }}>
                {% block datagrid_table_headers %}
                    {% include '@SidusDataGrid/partials/table_headers.html.twig' %}
                {% endblock %}
                {% block datagrid_table_body %}
                    <tbody>
                    {% for result in pager %}
                        <tr class="datagrid-row"{% if result.id is defined %} data-entity-id="{{ result.id }}"{% endif %}>
                            {% for column in datagrid.columns %}
                                <td{{ attributes(column.attributes) }}>
                                    {% if column.template %}
                                        {% include column.template with column.templateVars %}
                                    {% else %}
                                        {{ column.renderValue(result) }}
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ datagrid.columns|length }}" class="empty">No result</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                {% endblock %}
            </table>
        </div>
    {% endblock %}

    {% block form_end %}
        </div>
        {{ form_end(form) }}
    {% endblock %}

{% endblock %}
