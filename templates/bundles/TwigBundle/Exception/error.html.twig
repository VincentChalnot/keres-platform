{% extends 'base.html.twig' %}
{% trans_default_domain 'pages' %}

{% set error_titles = {
    403: 'error.403.title'|trans,
    404: 'error.404.title'|trans,
    500: 'error.500.title'|trans,
    503: 'error.503.title'|trans,
} %}

{% set error_messages = {
    403: 'error.403.message'|trans,
    404: 'error.404.message'|trans,
    500: 'error.500.message'|trans,
    503: 'error.503.message'|trans,
}%}

{% set error_title = error_titles[status_code] ?? 'error.generic_title'|trans({code: status_code}) %}
{% set error_message = error_messages[status_code] ?? status_text %}

{% block title %}{{ error_title }} - Keres{% endblock %}

{% block body %}
    <section class="section error-page">
        <div class="container has-text-centered error-page__content">
            <p class="error-page__code">{{ status_code }}</p>
            <h2>{{ error_title }}</h2>
            <p class="error-page__message">{{ error_message }}</p>
            <div class="buttons is-centered">
                {% if app.user %}
                    <a href="{{ path('lobby') }}" class="button is-primary is-rounded">{{ 'error.back_to_games'|trans }}</a>
                {% else %}
                    <a href="{{ static_site_url }}/" class="button is-primary is-rounded">{{ 'error.back_to_home'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
