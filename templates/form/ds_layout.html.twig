{#
    Symfony form theme on the design system's form classes (src/components/forms.css):
    .field > .label + .input|.textarea|.select|.checkbox|.radio + .help (+ .help--danger for errors),
    buttons .btn (--primary for submit). Registered in config/packages/twig.yaml.
    An invalid widget gets `.is-invalid` (red border/ring). Classes passed in `attr` are kept.
#}
{% use 'form_div_layout.html.twig' %}

{# Rows #}

{%- block form_row -%}
    <div class="field">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block checkbox_row -%}
    <div class="field">
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block radio_row -%}
    <div class="field">
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock radio_row -%}

{%- block button_row -%}
    <div class="field">
        {{- form_widget(form) -}}
    </div>
{%- endblock button_row -%}

{# Labels #}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{# Help / errors #}

{%- block form_help -%}
    {%- if help -%}
        <p class="help">{{ block('form_help_content') }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- for error in errors -%}
            <p class="help help--danger">{{ error.message }}</p>
        {%- endfor -%}
    {%- endif -%}
{%- endblock form_errors -%}

{# Widgets #}

{%- block form_widget_simple -%}
    {%- if type is not defined or type != 'hidden' -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input' ~ (valid ? '' : ' is-invalid'))|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' textarea' ~ (valid ? '' : ' is-invalid'))|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{# `.select` styles the <select> itself (no wrapper element). #}
{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' select' ~ (valid ? '' : ' is-invalid'))|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_expanded -%}
    <div class="{{ multiple ? 'checkboxes' : 'radios' }}"{{ block('widget_container_attributes') }}>
        {%- for child in form -%}
            {{- form_widget(child) -}}
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_widget -%}
    <label class="checkbox">
        <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        {{ block('form_label_content') }}
    </label>
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    <label class="radio">
        <input type="radio" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        {{ block('form_label_content') }}
    </label>
{%- endblock radio_widget -%}

{# Buttons: `btn` unless the caller already set it, submit defaults to the primary variant, reset to the outline one. #}
{%- block button_widget -%}
    {%- if 'btn' not in attr.class|default('')|split(' ') -%}
        {%- set attr = attr|merge({class: ('btn ' ~ attr.class|default(''))|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock button_widget -%}

{# A translated label can be longer than a phone is wide: submit buttons may wrap (`btn--wrap`). #}
{%- block submit_widget -%}
    {%- if 'btn--' not in attr.class|default('') -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' btn--primary')|trim}) -%}
    {%- endif -%}
    {%- if 'btn--wrap' not in attr.class|default('') -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' btn--wrap')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock submit_widget -%}

{%- block reset_widget -%}
    {%- if 'btn--' not in attr.class|default('') -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' btn--outline')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock reset_widget -%}
