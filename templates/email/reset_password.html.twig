{% extends 'email/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}{{ 'reset_password.subject'|trans }}{% endblock %}

{% block content %}
    <p style="margin:0 0 16px 0;">{{ 'greeting.named'|trans({name: user.displayName ?? user.email}) }}</p>

    <p style="margin:0 0 16px 0;">{{ 'reset_password.intro'|trans }}</p>

    <p style="margin:0 0 24px 0;">
        <a href="{{ resetUrl }}" style="display:inline-block; background-color:#e19e5b; color:#1a1208; padding:12px 28px; border-radius:9999px; text-decoration:none; font-weight:bold;">{{ 'reset_password.button'|trans }}</a>
    </p>

    <p style="margin:0;">{{ 'reset_password.expiry'|trans }}</p>
{% endblock %}
