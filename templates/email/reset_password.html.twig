{% extends 'email/_layout.html.twig' %}

{% block title %}Reset your Keres password{% endblock %}

{% block content %}
    <p style="margin:0 0 16px 0;">Hello {{ user.displayName ?? user.email }},</p>

    <p style="margin:0 0 16px 0;">We received a request to reset the password for your Keres account.</p>

    <p style="margin:0 0 24px 0;">
        <a href="{{ resetUrl }}" style="display:inline-block; background-color:#e19e5b; color:#1a1208; padding:12px 28px; border-radius:9999px; text-decoration:none; font-weight:bold;">Choose a new password</a>
    </p>

    <p style="margin:0;">This link expires in 1 hour. If you did not request a password reset, you can safely ignore this email.</p>
{% endblock %}
