{% extends 'email/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}{{ 'notification_game_finished.subject'|trans }}{% endblock %}

{% block content %}
    <p style="margin:0 0 16px 0;">{{ 'greeting.named'|trans({name: recipient.username}) }}</p>

    <p style="margin:0 0 16px 0;">
        {{ 'notification_game_finished.outcome'|trans({outcome: outcome ?? 'other'}) }}
    </p>

    <p style="margin:0;">
        <a href="{{ playUrl }}" style="display:inline-block; background-color:#e19e5b; color:#1a1208; padding:12px 28px; border-radius:9999px; text-decoration:none; font-weight:bold;">{{ 'notification_game_finished.button'|trans }}</a>
    </p>
{% endblock %}
