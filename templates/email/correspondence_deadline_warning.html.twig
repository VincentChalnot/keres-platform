{% extends 'email/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}{{ 'correspondence_deadline_warning.subject'|trans }}{% endblock %}

{% block content %}
    <p style="margin:0 0 16px 0;">{{ 'greeting.named'|trans({name: user.username}) }}</p>

    <p style="margin:0 0 16px 0;">{{ 'correspondence_deadline_warning.body'|trans }}</p>

    <p style="margin:0 0 24px 0;">
        <a href="{{ playUrl }}" style="display:inline-block; background-color:#e19e5b; color:#1a1208; padding:12px 28px; border-radius:9999px; text-decoration:none; font-weight:bold;">{{ 'correspondence_deadline_warning.button'|trans }}</a>
    </p>

    <p style="margin:0;">{{ 'correspondence_deadline_warning.reason'|trans }}</p>
{% endblock %}
