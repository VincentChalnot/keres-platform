{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'play_guest.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="notification is-dark is-light guest-game-notice">
            {{ 'play_guest.notice.intro'|trans }}
            <a href="{{ path('login') }}">{{ 'play_guest.notice.sign_in'|trans }}</a> {{ 'play_guest.notice.or'|trans }} <a href="{{ path('register') }}">{{ 'play_guest.notice.create_account'|trans }}</a> {{ 'play_guest.notice.outro'|trans }}
        </div>
    </div>
    {# Opponent type and side are resolved client-side (query string on a new game, localStorage on reload). #}
    {% include 'actions/_play_board.html.twig' with {
        opponentType: 0,
        moves: '',
        gameUuid: null,
        playerWhite: true,
        spectator: false,
        guest: true,
        isAi: true,
        gameOver: false,
        gameStateBootstrap: null,
    } %}
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('play') }}
{% endblock %}
