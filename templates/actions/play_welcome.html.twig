{% extends 'base.html.twig' %}

{% block title %}Play Keres online{% endblock %}

{% block body %}
    <section class="section lobby-hero">
        <div class="container">
            <div class="columns is-vcentered">
                <div class="column is-7">
                    <h1 class="title is-1">Play Keres online</h1>
                    <p class="subtitle is-4">Sign in to find opponents, play rated games, and keep your history.</p>

                    <div class="buttons">
                        <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="button is-rounded is-primary is-medium">
                            <span class="icon"><i class="fa-brands fa-google" aria-hidden="true"></i></span>
                            <span>Continue with Google</span>
                        </a>
                        <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="button is-rounded is-primary is-medium">
                            <span class="icon"><i class="fa-brands fa-discord" aria-hidden="true"></i></span>
                            <span>Continue with Discord</span>
                        </a>
                    </div>
                    <div class="buttons">
                        <a href="{{ path('register') }}" class="button is-rounded is-primary is-outlined">Create an account</a>
                        <a href="{{ path('login') }}" class="button is-rounded is-text">Sign in</a>
                    </div>

                    <hr>

                    <p class="mb-3 has-text-grey">Just want to try it?</p>
                    <a href="{{ path('new_local_game') }}" class="button is-rounded is-outlined is-light is-small">
                        <span class="icon"><i class="fa-solid fa-chess-board" aria-hidden="true"></i></span>
                        <span>Play the AI or hot-seat without an account</span>
                    </a>
                    <p class="help mt-2">Guest games live in this browser only: they aren't rated or saved to an account.</p>
                </div>
                <div class="column is-5 has-text-centered">
                    <img src="{{ asset('images/gameplay-preview.webp') }}" alt="A Keres game in progress" class="lobby-hero__image">
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="columns">
                <div class="column is-5">
                    <h2 class="title is-4">Announcements</h2>
                    {% for announcement in announcements %}
                        <div class="box mb-4">
                            <p class="title is-6">{{ announcement.title }}</p>
                            <p>{{ announcement.body }}</p>
                        </div>
                    {% endfor %}
                </div>
                <div class="column is-7">
                    <h2 class="title is-4">Recently finished games</h2>
                    {% for game in publicGames %}
                        {# @var game \App\Entity\Game #}
                        {% include 'actions/_game_row.html.twig' with {row: game_list_row(game, game.createdBy, false), isSelf: false} %}
                    {% else %}
                        <p class="has-text-grey">No finished games to show yet.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
