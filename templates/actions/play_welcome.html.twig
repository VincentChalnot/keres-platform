{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'welcome.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page">
            <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12">
                <div class="md:col-span-7">
                    <h1 class="page-title !text-5xl">{{ 'welcome.heading'|trans }}</h1>
                    <p class="page-subtitle">{{ 'welcome.subtitle'|trans }}</p>

                    <div class="mb-3 flex max-w-sm flex-col gap-3">
                        <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-google" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_google'|trans }}</span>
                        </a>
                        <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-discord" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_discord'|trans }}</span>
                        </a>
                    </div>
                    <div class="btn-group">
                        <a href="{{ path('register') }}" class="btn btn--outline">{{ 'welcome.create_account'|trans }}</a>
                        <a href="{{ path('login') }}" class="btn btn--text">{{ 'welcome.sign_in'|trans }}</a>
                    </div>

                    <hr class="my-6 border-line">

                    <p class="mb-3 text-muted">{{ 'welcome.try_it'|trans }}</p>
                    <a href="{{ path('new_local_game') }}" class="btn btn--outline btn--sm">
                        <span class="icon"><i class="fa-solid fa-chess-board" aria-hidden="true"></i></span>
                        <span>{{ 'welcome.try_button'|trans }}</span>
                    </a>
                    <p class="help mt-2">{{ 'welcome.guest_help'|trans }}</p>
                </div>
                <div class="text-center md:col-span-5">
                    <img src="{{ asset('images/gameplay-preview.webp') }}" alt="{{ 'welcome.image_alt'|trans }}" class="mx-auto max-w-full rounded-md">
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-page">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
                <div class="md:col-span-5">
                    <h2 class="mb-4 font-title text-2xl">{{ 'welcome.announcements.title'|trans }}</h2>
                    <div class="card">
                        <h3 class="card__title card__title--sm">{{ 'welcome.announcements.no_account.title'|trans }}</h3>
                        <p class="mb-0">{{ 'welcome.announcements.no_account.body'|trans }}</p>
                    </div>
                    <div class="card">
                        {% include 'actions/_announcements.html.twig' with {announcements: announcements, visible: 3} only %}
                    </div>
                </div>
                <div class="md:col-span-7">
                    <h2 class="mb-4 font-title text-2xl">{{ 'welcome.recent_games.title'|trans }}</h2>
                    {% for game in publicGames %}
                        {# @var game \App\Entity\Game #}
                        {% include 'actions/_game_row.html.twig' with {row: public_game_list_row(game), isSelf: false} %}
                    {% else %}
                        <p class="text-muted">{{ 'welcome.recent_games.empty'|trans }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
