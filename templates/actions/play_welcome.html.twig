{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'welcome.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section lobby-hero">
        <div class="container">
            <div class="columns is-vcentered">
                <div class="column is-7">
                    <h1 class="title is-1">{{ 'welcome.heading'|trans }}</h1>
                    <p class="subtitle is-4">{{ 'welcome.subtitle'|trans }}</p>

                    <div class="buttons">
                        <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="button is-rounded is-primary is-medium">
                            <span class="icon"><i class="fa-brands fa-google" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_google'|trans }}</span>
                        </a>
                        <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="button is-rounded is-primary is-medium">
                            <span class="icon"><i class="fa-brands fa-discord" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_discord'|trans }}</span>
                        </a>
                    </div>
                    <div class="buttons">
                        <a href="{{ path('register') }}" class="button is-rounded is-primary is-outlined">{{ 'welcome.create_account'|trans }}</a>
                        <a href="{{ path('login') }}" class="button is-rounded is-text">{{ 'welcome.sign_in'|trans }}</a>
                    </div>

                    <hr>

                    <p class="mb-3 has-text-grey">{{ 'welcome.try_it'|trans }}</p>
                    <a href="{{ path('new_local_game') }}" class="button is-rounded is-outlined is-light is-small">
                        <span class="icon"><i class="fa-solid fa-chess-board" aria-hidden="true"></i></span>
                        <span>{{ 'welcome.try_button'|trans }}</span>
                    </a>
                    <p class="help mt-2">{{ 'welcome.guest_help'|trans }}</p>
                </div>
                <div class="column is-5 has-text-centered">
                    <img src="{{ asset('images/gameplay-preview.webp') }}" alt="{{ 'welcome.image_alt'|trans }}" class="lobby-hero__image">
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="columns">
                <div class="column is-5">
                    <h2 class="title is-4">{{ 'welcome.announcements.title'|trans }}</h2>
                    {% for announcement in announcements %}
                        <div class="box mb-4">
                            <p class="title is-6">{{ announcement.title }}</p>
                            <p>{{ announcement.body }}</p>
                        </div>
                    {% endfor %}
                </div>
                <div class="column is-7">
                    <h2 class="title is-4">{{ 'welcome.recent_games.title'|trans }}</h2>
                    {% for game in publicGames %}
                        {# @var game \App\Entity\Game #}
                        {% include 'actions/_game_row.html.twig' with {row: public_game_list_row(game), isSelf: false} %}
                    {% else %}
                        <p class="has-text-grey">{{ 'welcome.recent_games.empty'|trans }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
