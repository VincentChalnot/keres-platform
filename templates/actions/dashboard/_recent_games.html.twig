{% trans_default_domain 'game' %}
<div class="card">
    <h2 class="card__title">{{ 'dashboard.recent_games.title'|trans }}</h2>
    {% for game in recentGames %}
        {# @var game \App\Entity\Game #}
        {% include 'actions/_game_row.html.twig' with {row: game_list_row(game, app.user, true), isSelf: true} %}
    {% else %}
        <p class="text-muted">{{ 'game_list.empty.in_progress'|trans }}</p>
    {% endfor %}
    {% if inProgressCount > recentGames|length %}
        <p><a href="{{ path('game_list') }}">{{ 'game_list.view_all'|trans({count: inProgressCount}) }}</a></p>
    {% endif %}
    <a href="{{ path('lobby') }}" class="btn btn--primary btn--block mt-3">{{ 'dashboard.recent_games.new_game'|trans }}</a>
</div>
