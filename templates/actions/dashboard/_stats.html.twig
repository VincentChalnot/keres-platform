{% trans_default_domain 'game' %}
<div class="card">
    <h2 class="card__title">{{ 'dashboard.stats.title'|trans }}</h2>
    <div class="stat-row">
        <div class="stat">
            <p class="stat__label">{{ 'dashboard.stats.wins'|trans }}</p>
            <p class="stat__value">{{ stats.wins }}</p>
        </div>
        <div class="stat">
            <p class="stat__label">{{ 'dashboard.stats.losses'|trans }}</p>
            <p class="stat__value">{{ stats.losses }}</p>
        </div>
        <div class="stat">
            <p class="stat__label">{{ 'dashboard.stats.draws'|trans }}</p>
            <p class="stat__value">{{ stats.draws }}</p>
        </div>
    </div>
    {% if winRate is not null %}
        <p class="mb-0 mt-3 text-center">{{ 'dashboard.stats.win_rate_label'|trans }} <strong>{{ 'dashboard.stats.win_rate_value'|trans({rate: winRate}) }}</strong> {{ 'dashboard.stats.win_rate_basis'|trans({count: totalFinished}) }}</p>
    {% else %}
        <p class="mb-0 mt-3 text-center text-muted">{{ 'dashboard.stats.empty'|trans }}</p>
    {% endif %}
    <hr class="announcements__rule">
    <h3 class="card__title card__title--sm">{{ 'list.title'|trans({}, 'announcements') }}</h3>
    {% include 'actions/_announcements.html.twig' with {announcements: announcements} only %}
</div>
