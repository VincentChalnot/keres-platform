{% extends 'base.html.twig' %}
{% trans_default_domain 'social' %}

{% block title %}{{ 'friends.page_title'|trans }}{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="mercure-url" content="{{ mercure() }}">
{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page">
            <h1 class="page-title mb-6">{{ 'friends.title'|trans }}</h1>

            <div id="friends-root" data-user-uuid="{{ userUuid }}">
                <script type="application/json" id="friends-bootstrap">{{ friendsBootstrap|raw }}</script>

                <div class="card">
                    <h2 class="card__title">{{ 'friends.search.title'|trans }}</h2>
                    <div class="field">
                        <input class="input" type="text" id="friends-search-input" placeholder="{{ 'friends.search.placeholder'|trans }}" autocomplete="off">
                    </div>
                    <div id="friends-search-results"></div>
                </div>

                <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="card !mb-0">
                        <h2 class="card__title">{{ 'friends.incoming_title'|trans }}</h2>
                        <ul id="friends-incoming-list" class="friend-list"></ul>
                    </div>
                    <div class="card !mb-0">
                        <h2 class="card__title">{{ 'friends.outgoing_title'|trans }}</h2>
                        <ul id="friends-outgoing-list" class="friend-list"></ul>
                    </div>
                </div>

                <div class="card">
                    <h2 class="card__title">{{ 'friends.accepted_title'|trans }}</h2>
                    <ul id="friends-accepted-list" class="friend-list"></ul>
                </div>

                {% set privacy_link %}<a href="{{ path('settings_privacy') }}">{{ 'friends.blocked_note_link'|trans }}</a>{% endset %}
                <p class="text-muted">{{ 'friends.blocked_note'|trans({link: privacy_link})|raw }}</p>
            </div>
        </div>
    </section>
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
