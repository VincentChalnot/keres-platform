{% extends 'base.html.twig' %}

{% block title %}Friends{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="mercure-url" content="{{ mercure() }}">
{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <h1 class="title">Friends</h1>

            <div id="friends-root" data-user-uuid="{{ userUuid }}">
                <script type="application/json" id="friends-bootstrap">{{ friendsBootstrap|raw }}</script>

                <div class="box">
                    <h3 class="title is-5">Find players</h3>
                    <div class="field">
                        <div class="control">
                            <input class="input" type="text" id="friends-search-input" placeholder="Search by username (3+ characters)" autocomplete="off">
                        </div>
                    </div>
                    <div id="friends-search-results"></div>
                </div>

                <div class="columns is-multiline">
                    <div class="column is-half">
                        <div class="box">
                            <h3 class="title is-5">Received requests</h3>
                            <ul id="friends-incoming-list" class="friends-list"></ul>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box">
                            <h3 class="title is-5">Sent requests</h3>
                            <ul id="friends-outgoing-list" class="friends-list"></ul>
                        </div>
                    </div>
                </div>

                <div class="box">
                    <h3 class="title is-5">Your friends</h3>
                    <ul id="friends-accepted-list" class="friends-list"></ul>
                </div>

                <div class="box">
                    <h3 class="title is-5">Blocked users</h3>
                    <ul id="friends-blocked-list" class="friends-list"></ul>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
