{% extends 'base.html.twig' %}

{% block title %}Lobby - Keres{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="mercure-url" content="{{ mercure() }}">
{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <h1 class="title">Lobby</h1>
            <p class="subtitle">Post a seek, or join someone else's.</p>

            <div id="lobby-root" data-user-uuid="{{ app.user.id }}">
                <script type="application/json" id="lobby-bootstrap">{{ seeksBootstrap|raw }}</script>

                <div class="box lobby-new-seek">
                    <h3 class="title is-5">New seek</h3>
                    <form id="lobby-seek-form" data-default-preset="{{ defaultPreset }}">
                        <div class="field">
                            <label class="label" id="lobby-preset-label">Format</label>
                            <div class="buttons lobby-presets" role="group" aria-labelledby="lobby-preset-label">
                                {% for key, preset in presets %}
                                    <button type="button"
                                            class="button is-rounded is-outlined is-light"
                                            aria-pressed="false"
                                            data-preset="{{ key }}"
                                            data-kind="{{ preset.kind }}"
                                            {% if preset.kind == 'realtime' %}
                                                data-initial-minutes="{{ preset.initialMinutes }}"
                                                data-increment-seconds="{{ preset.incrementSeconds }}"
                                            {% else %}
                                                data-days-per-move="{{ preset.daysPerMove }}"
                                            {% endif %}>
                                        <span>{{ preset.label }}</span>
                                        <span class="lobby-presets__value">
                                            {%- if preset.kind == 'realtime' -%}
                                                {{ preset.initialMinutes }}+{{ preset.incrementSeconds }}
                                            {%- else -%}
                                                {{ preset.daysPerMove }} day{{ preset.daysPerMove > 1 ? 's' }}
                                            {%- endif -%}
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>
                            <p class="help">A format fills in the form below. Adjust anything, then post your seek.</p>
                        </div>

                        <div class="columns is-multiline">
                            <div class="column is-one-third">
                                <div class="field">
                                    <label class="label" for="lobby-seek-kind">Time control</label>
                                    <div class="control">
                                        <div class="select is-fullwidth">
                                            <select name="kind" id="lobby-seek-kind">
                                                <option value="realtime">Real-time</option>
                                                <option value="correspondence">Correspondence</option>
                                                <option value="unlimited">Unlimited</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="column is-one-third" data-field="realtime">
                                <div class="field">
                                    <label class="label" for="lobby-seek-initial">Initial time (minutes)</label>
                                    <div class="control">
                                        <input class="input" type="number" id="lobby-seek-initial" name="initialMinutes" min="1" max="180" step="1" required>
                                    </div>
                                </div>
                            </div>
                            <div class="column is-one-third" data-field="realtime">
                                <div class="field">
                                    <label class="label" for="lobby-seek-increment">Increment (seconds per move)</label>
                                    <div class="control">
                                        <input class="input" type="number" id="lobby-seek-increment" name="incrementSeconds" min="0" max="180" step="1" required>
                                    </div>
                                </div>
                            </div>
                            <div class="column is-one-third" data-field="correspondence" hidden>
                                <div class="field">
                                    <label class="label" for="lobby-seek-days">Days per move</label>
                                    <div class="control">
                                        <div class="select is-fullwidth">
                                            <select name="daysPerMove" id="lobby-seek-days">
                                                <option value="1">1 day</option>
                                                <option value="3">3 days</option>
                                                <option value="7">7 days</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="column is-one-third">
                                <div class="field">
                                    <label class="label" for="lobby-seek-color">Colour</label>
                                    <div class="control">
                                        <div class="select is-fullwidth">
                                            <select name="colorPreference" id="lobby-seek-color">
                                                <option value="random">Random</option>
                                                <option value="white">White</option>
                                                <option value="black">Black</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="column is-one-third">
                                <div class="field">
                                    <label class="label" for="lobby-seek-rated">Rated</label>
                                    <div class="control">
                                        <div class="select is-fullwidth">
                                            <select name="rated" id="lobby-seek-rated">
                                                <option value="true">Rated</option>
                                                <option value="false">Casual</option>
                                            </select>
                                        </div>
                                    </div>
                                    <p class="help" data-field="unlimited" hidden>Unlimited games are always casual.</p>
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <button type="submit" class="button is-primary is-rounded">Post seek</button>
                        </div>
                    </form>
                </div>

                <div class="box">
                    <h3 class="title is-5">Open seeks <span class="has-text-grey-light" id="lobby-pool-size"></span></h3>
                    <table class="table is-fullwidth" id="lobby-seek-table">
                        <thead>
                        <tr>
                            <th>Player</th>
                            <th>Time control</th>
                            <th>Rated</th>
                            <th>Colour</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody id="lobby-seek-table-body"></tbody>
                    </table>
                </div>

                <div class="box">
                    <h3 class="title is-5">Prefer a computer or a local opponent?</h3>
                    <a href="{{ path('new_local_game') }}" class="button is-rounded is-outlined is-light">Play AI or hot-seat</a>
                    {% if ongoingGames|length > 0 %}
                        <a href="{{ path('game_list') }}" class="button is-rounded is-outlined is-light">Your games ({{ ongoingGames|length }})</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
