{#
    The board page shared by persisted games (play.html.twig) and browser-only
    guest games (play_guest.html.twig). Variables:
      opponentType (int), moves (base64), gameUuid (?string), playerWhite (bool),
      spectator (bool), guest (bool), isAi (bool), gameOver (bool),
      gameStateBootstrap (?string, JSON), showCoordinates (bool), showThreats (bool),
      aiLevel (?int, T10 - undefined for guest games),
      liveEvaluation (bool, optional - the evaluation bar was requested at creation; unrated games only)
#}
    <div class="game-container"
         id="game-container"
         data-opponent-type="{{ opponentType }}">
        {% if gameStateBootstrap %}
            <script type="application/json" id="game-state-bootstrap">{{ gameStateBootstrap|raw }}</script>
        {% endif %}

        {% if isAi and aiLevel is defined and aiLevel %}
            <p class="has-text-grey is-size-7 mb-2" id="ai-level-indicator">vs AI (level {{ aiLevel }})</p>
        {% endif %}

        <div class="player-info-row" id="player-info-top">
            <div class="material-bar" id="material-top"></div>
            <div class="player-clock" id="clock-top"><span class="player-clock__time">--:--</span></div>
        </div>
        <div class="board-with-eval" id="board-with-eval">
        <div class="eval-bar" id="eval-bar" hidden aria-label="Engine evaluation" role="img">
            <div class="eval-bar__white" id="eval-bar-white"></div>
            <span class="eval-bar__label" id="eval-bar-label"></span>
        </div>
        <div id="board-container"
             data-moves="{{ moves }}"
             {% if gameUuid %}data-game-uuid="{{ gameUuid }}"{% endif %}
             data-opponent-type="{{ opponentType }}"
             data-player-white="{{ playerWhite ? 'true' : 'false' }}"
             data-spectator="{{ spectator ? 'true' : 'false' }}"
             data-guest="{{ guest ? 'true' : 'false' }}"
             data-show-coordinates="{{ showCoordinates ?? true ? 'true' : 'false' }}"
             data-show-threats="{{ showThreats ?? true ? 'true' : 'false' }}"
             data-live-evaluation="{{ liveEvaluation ?? false ? 'true' : 'false' }}"></div>
        </div>
        <div class="player-info-row" id="player-info-bottom">
            <div class="material-bar" id="material-bottom"></div>
            <div class="player-clock" id="clock-bottom"><span class="player-clock__time">--:--</span></div>
        </div>

        <div class="notification game-status-banner is-muted" id="game-status-banner" role="status" aria-live="polite">Loading…</div>

        <div class="buttons mt-3">
            {% if isAi %}
                <button class="button is-rounded is-outlined is-light" id="switch-sides-btn">Switch Sides</button>
            {% endif %}
            <button class="button is-rounded is-outlined is-light" id="toggle-threats-btn">Hide Threats</button>
            <button class="button is-rounded is-outlined is-light" id="toggle-coords-btn">Hide Coords</button>
            <button class="button is-rounded is-outlined is-light" id="toggle-fullscreen-btn">Fullscreen</button>
            <button class="button is-rounded is-light" id="undo-btn">Undo</button>
            {% if not gameOver %}
                <button type="button" class="button is-rounded is-danger" id="resign-btn">Resign</button>
            {% endif %}
            {% if app.user %}
                <button type="button" class="button is-rounded is-outlined is-light" id="feedback-btn">Feedback</button>
            {% endif %}
        </div>
        <div class="move-history">
            <label class="label">Move History</label>
            <div class="buttons">
                <button class="button is-rounded is-small is-outlined is-light" id="prev-move-btn" title="Previous Move">◄ Prev</button>
                <button class="button is-rounded is-small is-outlined is-light" id="next-move-btn" title="Next Move">Next ►</button>
            </div>
            <div id="move-history-display" class="move-history-box">
                <table class="table is-fullwidth move-history-table">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>White</th>
                        <th>Black</th>
                    </tr>
                    </thead>
                    <tbody id="move-history-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal" id="unstack-modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title" id="unstack-modal-title">Choose your move</p>
            </header>
            <section class="modal-card-body">
                <p id="unstack-modal-text">You are moving a stacked piece. Do you want to move the full stack or only the top piece?</p>
            </section>
            <footer class="modal-card-foot">
                <button class="button is-primary" id="move-stack">Move Full Stack</button>
                <button class="button" id="move-unstack">Move Top Piece</button>
                <button class="button" id="select-instead" hidden>Select this piece</button>
            </footer>
        </div>
    </div>

    <div class="modal" id="feedback-modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Feedback</p>
                <button class="delete" aria-label="close" id="feedback-modal-close"></button>
            </header>
            <section class="modal-card-body" id="feedback-modal-body">
                <progress class="progress is-small is-primary" max="100">Loading</progress>
            </section>
        </div>
    </div>
