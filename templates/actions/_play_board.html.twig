{#
    The board page shared by persisted games (play.html.twig) and browser-only
    guest games (play_guest.html.twig). Variables:
      opponentType (int), moves (base64), gameUuid (?string), playerWhite (bool),
      spectator (bool), guest (bool), isAi (bool), gameOver (bool),
      gameStateBootstrap (?string, JSON), showCoordinates (bool), showThreats (bool),
      gameHeader (?\App\Model\GameHeader - players + option badges; undefined for guest games),
      liveEvaluation (bool, optional - the evaluation bar was requested at creation; unrated games only)
#}
{% trans_default_domain 'game' %}
    <div class="game-container"
         id="game-container"
         data-opponent-type="{{ opponentType }}">
        {% if gameStateBootstrap %}
            <script type="application/json" id="game-state-bootstrap">{{ gameStateBootstrap|raw }}</script>
        {% endif %}

        {% if gameHeader is defined and gameHeader %}
            {% include 'actions/_game_header.html.twig' with {header: gameHeader} only %}
        {% endif %}

        {# Opponent row, board, own row: one unit. Plain flow (display: contents) normally; in page fullscreen it is the viewport-sized stage the board is fitted into. #}
        <div class="game-stage">
        <div class="player-info-row" id="player-info-top">
            <div class="material-bar" id="material-top"></div>
            <div class="player-clock" id="clock-top"><span class="player-clock__time">--:--</span></div>
        </div>
        <div class="board-with-eval" id="board-with-eval">
        <div class="eval-bar" id="eval-bar" hidden aria-label="{{ 'play.board.eval_bar'|trans }}" role="img">
            <div class="eval-bar__white" id="eval-bar-white"></div>
            <span class="eval-bar__label" id="eval-bar-label"></span>
        </div>
        <div id="board-container"
             data-moves="{{ moves }}"
             {% if gameUuid %}data-game-uuid="{{ gameUuid }}"{% endif %}
             data-opponent-type="{{ opponentType }}"
             data-player-white="{{ playerWhite ? 'true' : 'false' }}"
             data-spectator="{{ spectator ? 'true' : 'false' }}"
             data-guest="{{ guest ? 'true' : 'false' }}"
             data-show-coordinates="{{ showCoordinates ?? true ? 'true' : 'false' }}"
             data-show-threats="{{ showThreats ?? true ? 'true' : 'false' }}"
             data-live-evaluation="{{ liveEvaluation ?? false ? 'true' : 'false' }}"
             data-can-evaluate="{{ app.user ? 'true' : 'false' }}"
             data-game-over-label="{{ 'play.board.game_over'|trans }}"></div>
        </div>
        <div class="player-info-row" id="player-info-bottom">
            <div class="material-bar" id="material-bottom"></div>
            <div class="player-clock" id="clock-bottom"><span class="player-clock__time">--:--</span></div>
        </div>
        </div>

        <div class="notification game-status-banner is-muted" id="game-status-banner" role="status" aria-live="polite">{{ 'play.board.loading'|trans }}</div>

        <div class="buttons mt-3">
            {% if isAi %}
                <button class="button is-rounded is-outlined is-light" id="switch-sides-btn">{{ 'play.board.switch_sides'|trans }}</button>
            {% endif %}
            <button class="button is-rounded is-outlined is-light" id="toggle-threats-btn">{{ 'play.board.hide_threats'|trans }}</button>
            <button class="button is-rounded is-outlined is-light" id="toggle-coords-btn">{{ 'play.board.hide_coords'|trans }}</button>
            <button class="button is-rounded is-outlined is-light" id="toggle-fullscreen-btn">{{ 'play.board.fullscreen'|trans }}</button>
            <button class="button is-rounded is-outlined is-light" id="toggle-rotate-btn" type="button" title="{{ 'play.board.rotate_opponent'|trans }}" aria-label="{{ 'play.board.rotate_opponent'|trans }}" aria-pressed="false"><span class="icon"><i class="fa-solid fa-rotate" aria-hidden="true"></i></span><span id="toggle-rotate-label">{{ 'play.board.rotate_opponent'|trans }}</span></button>
            <button class="button is-rounded is-light" id="undo-btn">{{ 'play.board.undo'|trans }}</button>
            {% if not gameOver %}
                <button type="button" class="button is-rounded is-danger" id="resign-btn">{{ 'play.board.resign'|trans }}</button>
            {% endif %}
            {% if app.user %}
                <button type="button" class="button is-rounded is-outlined is-light" id="feedback-btn">{{ 'play.board.feedback'|trans }}</button>
            {% endif %}
        </div>
        <div class="move-history">
            <label class="label">{{ 'play.board.history.title'|trans }}</label>
            <div class="buttons">
                <button class="button is-rounded is-small is-outlined is-light" id="prev-move-btn" title="{{ 'play.board.history.previous_title'|trans }}">{{ 'play.board.history.previous'|trans }}</button>
                <button class="button is-rounded is-small is-outlined is-light" id="next-move-btn" title="{{ 'play.board.history.next_title'|trans }}">{{ 'play.board.history.next'|trans }}</button>
            </div>
            <div id="move-history-display" class="move-history-box">
                <table class="table is-fullwidth move-history-table">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'color.white'|trans }}</th>
                        <th>{{ 'color.black'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody id="move-history-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal" id="unstack-modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title" id="unstack-modal-title">{{ 'play.board.unstack_modal.title'|trans }}</p>
            </header>
            <section class="modal-card-body">
                <p id="unstack-modal-text">{{ 'play.board.unstack_modal.text'|trans }}</p>
            </section>
            <footer class="modal-card-foot is-flex-wrap-wrap" style="gap: 0.5rem;">
                <button class="button is-primary" id="move-stack">{{ 'play.board.unstack_modal.move_stack'|trans }}</button>
                <button class="button" id="move-unstack">{{ 'play.board.unstack_modal.move_unstack'|trans }}</button>
                <button class="button is-hidden" id="select-instead">{{ 'play.board.unstack_modal.select_instead'|trans }}</button>
            </footer>
        </div>
    </div>

    <div class="modal" id="feedback-modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">{{ 'play.board.feedback_modal.title'|trans }}</p>
                <button class="delete" aria-label="{{ 'play.board.feedback_modal.close'|trans }}" id="feedback-modal-close"></button>
            </header>
            <section class="modal-card-body" id="feedback-modal-body">
                <progress class="progress is-small is-primary" max="100">{{ 'play.board.feedback_modal.loading'|trans }}</progress>
            </section>
        </div>
    </div>
