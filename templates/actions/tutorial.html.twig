{% extends 'base.html.twig' %}
{% trans_default_domain 'tutorial' %}

{% block title %}{{ 'page.title'|trans }}{% endblock %}

{% block body %}
    {# Slide captions: literal keys, in the order of TutorialContent::SLIDES. #}
    {% set captions = {
        'board': 'slides.board'|trans,
        'like-chess': 'slides.like_chess'|trans,
        'chess-pieces': 'slides.chess_pieces'|trans,
        'new-pieces': 'slides.new_pieces'|trans,
        'chess-only': 'slides.chess_only'|trans,
        'stacking': 'slides.stacking'|trans,
        'stack-moves': 'slides.stack_moves'|trans,
    } %}

    <section class="section">
        <div class="container-page container-page--narrow" id="tutorial" data-puzzle-url="{{ asset('tutorial/puzzle.json') }}">
            <h1 class="page-title">{{ 'page.title'|trans }}</h1>

            <div class="card" id="tutorial-slides">
                <p class="tutorial-progress" id="tutorial-progress" aria-live="polite"></p>

                {% for slide in slides %}
                    <figure class="tutorial-slide" data-slide{% if not loop.first %} hidden{% endif %}>
                        <img class="tutorial-slide__figure" src="{{ asset('tutorial/' ~ slide ~ '.svg') }}" alt="">
                        <figcaption class="tutorial-caption !mb-0">{{ captions[slide] }}</figcaption>
                    </figure>
                {% endfor %}

                <div class="btn-group btn-group--end mt-4">
                    <button type="button" class="btn btn--outline" id="tutorial-prev" disabled>{{ 'nav.previous'|trans }}</button>
                    <button type="button" class="btn btn--primary" id="tutorial-next">{{ 'nav.next'|trans }}</button>
                </div>
            </div>

            <div class="card" id="tutorial-puzzle" hidden>
                <p class="tutorial-caption" id="tutorial-caption" aria-live="polite"></p>
                <div class="tutorial-board" id="tutorial-board"></div>
                <p class="tutorial-message" id="tutorial-message" role="status"></p>
            </div>

            <div class="card" id="tutorial-end" hidden>
                <h2 class="card__title">{{ 'end.title'|trans }}</h2>

                {% if app.user %}
                    <div class="btn-group">
                        {% include 'actions/_quick_game_form.html.twig' with {quickGame: quickGame, opponent: 'ai', level: nextBot.level, label: 'end.play_bot'|trans({level: nextBot.level})} only %}
                        <a href="{{ path('lobby') }}" class="btn btn--outline">{{ 'end.lobby'|trans }}</a>
                    </div>
                {% else %}
                    <div class="mb-3 flex max-w-sm flex-col gap-3">
                        <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-google" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_google'|trans({}, 'game') }}</span>
                        </a>
                        <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-discord" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_discord'|trans({}, 'game') }}</span>
                        </a>
                    </div>
                    <div class="btn-group">
                        <a href="{{ path('register') }}" class="btn btn--outline">{{ 'end.create_account'|trans }}</a>
                        {% include 'actions/_quick_game_form.html.twig' with {quickGame: quickGame, opponent: 'ai', level: nextBot.level, label: 'end.play_guest'|trans({level: nextBot.level}), class: 'btn btn--outline'} only %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    {% include 'actions/_unstack_modal.html.twig' only %}
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('tutorial') }}
{% endblock %}
