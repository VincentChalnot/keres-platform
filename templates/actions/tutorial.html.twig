{% extends 'base.html.twig' %}
{% trans_default_domain 'tutorial' %}

{% block title %}{{ 'page.title'|trans }}{% endblock %}

{% block body %}
    {% include 'actions/_experience_modal.html.twig' with {active: true} only %}
    <section class="section">
        <div class="container-page container-page--narrow" id="tutorial" data-lessons-url="{{ asset('tutorial/lessons.json') }}" data-track="{{ track }}">
            <h1 class="page-title">{{ 'page.title'|trans }}</h1>

            {# The lessons of public/tutorial/lessons.json, played by tutorial.ts: progress dots, a title and a sentence, then
               static images and/or the live board, then the buttons. #}
            <div class="card" id="tutorial-lessons">
                <ol class="mb-3 flex list-none flex-wrap gap-2 p-0" id="tutorial-dots" aria-label="{{ 'page.title'|trans }}"></ol>
                <h2 class="card__title" id="tutorial-title"></h2>
                <p class="tutorial-caption" id="tutorial-caption" aria-live="polite"></p>
                <div class="mb-3 flex flex-col gap-3" id="tutorial-images"></div>
                <div class="tutorial-board" id="tutorial-board" hidden></div>
                <ul class="my-3 list-none p-0 text-sm" id="tutorial-notes"></ul>
                <p class="tutorial-message" id="tutorial-message" role="status"></p>

                <div class="btn-group btn-group--end mt-4">
                    <button type="button" class="btn btn--outline" id="tutorial-prev" disabled>{{ 'nav.previous'|trans }}</button>
                    <button type="button" class="btn btn--primary" id="tutorial-next">{{ 'nav.next'|trans }}</button>
                </div>
                <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                    <button type="button" class="btn btn--text btn--sm" id="tutorial-skip">{{ 'nav.skip_to_game'|trans }}</button>
                    <button type="button" class="btn btn--text btn--sm" id="tutorial-switch" data-label-chess="{{ 'track.chess'|trans }}" data-label-beginner="{{ 'track.beginner'|trans }}"></button>
                </div>
            </div>

            <div class="card" id="tutorial-end" hidden>
                <h2 class="card__title">{{ 'end.title'|trans }}</h2>

                {% if app.user %}
                    <div class="btn-group">
                        {% include 'actions/_quick_game_form.html.twig' with {quickGame: quickGame, opponent: 'ai', level: nextBot.level, id: 'tutorial-play-form', label: 'end.play_bot'|trans({level: nextBot.level})} only %}
                        <a href="{{ path('lobby') }}" class="btn btn--outline">{{ 'end.lobby'|trans }}</a>
                    </div>
                {% else %}
                    <div class="mb-3 flex max-w-sm flex-col gap-3">
                        <a href="{{ path('oidc_login', {provider: 'google'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-google" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_google'|trans({}, 'game') }}</span>
                        </a>
                        <a href="{{ path('oidc_login', {provider: 'discord'}) }}" class="btn btn--primary btn--block">
                            <span class="icon"><i class="fa-brands fa-discord" aria-hidden="true"></i></span>
                            <span>{{ 'welcome.continue_discord'|trans({}, 'game') }}</span>
                        </a>
                    </div>
                    <div class="btn-group">
                        <a href="{{ path('register') }}" class="btn btn--outline">{{ 'end.create_account'|trans }}</a>
                        {% include 'actions/_quick_game_form.html.twig' with {quickGame: quickGame, opponent: 'ai', level: nextBot.level, id: 'tutorial-play-form', label: 'end.play_guest'|trans({level: nextBot.level}), class: 'btn btn--outline'} only %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-page" id="pieces-and-rules">
            <h2 class="page-title !text-3xl">{{ 'reference.title'|trans }}</h2>
            {% include 'actions/_help_content.html.twig' with {mode: 'page', side: 'white'} only %}
        </div>
    </section>

    {% include 'actions/_diagram_modal.html.twig' only %}
    {% include 'actions/_unstack_modal.html.twig' only %}
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('tutorial') }}
{% endblock %}
