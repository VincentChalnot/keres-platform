{% extends 'base.html.twig' %}
{% trans_default_domain 'pages' %}

{% block title %}{{ 'waitlist.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page container-page--narrow">
            <div class="card">
                {% if confirmed %}
                    <h1 class="page-title">{{ 'waitlist.confirmed_title'|trans }}</h1>
                    <p class="page-subtitle">{{ 'waitlist.confirmed_text'|trans }}</p>
                {% else %}
                    <h1 class="page-title">{{ 'waitlist.invalid_title'|trans }}</h1>
                    <p class="page-subtitle">{{ 'waitlist.invalid_text'|trans }}</p>
                {% endif %}

                <p class="mb-0">
                    <a href="{{ path('lobby') }}">{{ 'waitlist.back'|trans }}</a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}
