{% extends 'base.html.twig' %}

{% block title %}Waitlist confirmation{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        {% if confirmed %}
                            <h3 class="title">You're on the list!</h3>
                            <p class="subtitle">Thanks for confirming — we'll email you when the physical edition is ready.</p>
                        {% else %}
                            <h3 class="title">This link is invalid or has expired</h3>
                            <p class="subtitle">Please sign up again from the physical edition page on our website.</p>
                        {% endif %}

                        <p class="mt-3">
                            <a href="{{ path('lobby') }}">Back to Keres</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
