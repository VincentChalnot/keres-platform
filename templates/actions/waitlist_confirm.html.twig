{% extends 'base.html.twig' %}
{% trans_default_domain 'pages' %}

{% block title %}{{ 'waitlist.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        {% if confirmed %}
                            <h3 class="title">{{ 'waitlist.confirmed_title'|trans }}</h3>
                            <p class="subtitle">{{ 'waitlist.confirmed_text'|trans }}</p>
                        {% else %}
                            <h3 class="title">{{ 'waitlist.invalid_title'|trans }}</h3>
                            <p class="subtitle">{{ 'waitlist.invalid_text'|trans }}</p>
                        {% endif %}

                        <p class="mt-3">
                            <a href="{{ path('lobby') }}">{{ 'waitlist.back'|trans }}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
