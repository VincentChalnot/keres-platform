{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'new_local_game.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        <h3 class="title">{{ 'new_local_game.title'|trans }}</h3>
                        <p class="subtitle">{{ 'new_local_game.subtitle.before'|trans }} <a href="{{ path('lobby') }}">{{ 'new_local_game.subtitle.link'|trans }}</a>{{ 'new_local_game.subtitle.after'|trans }}</p>

                        {{ form_start(form) }}

                        {% for name in ['playerSide', 'opponentType'] %}
                            <div class="field is-horizontal">
                                <div class="field-label is-normal">
                                    {{ form_label(form[name]) }}
                                </div>
                                <div class="field-body">
                                    <div class="field">
                                        <div class="control">
                                            {{ form_widget(form[name]) }}
                                        </div>
                                        {{ form_help(form[name]) }}
                                        {{ form_errors(form[name]) }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}

                        <div class="field is-horizontal" id="ai-level-field">
                            <div class="field-label is-normal">
                                {{ form_label(form.aiLevel) }}
                            </div>
                            <div class="field-body">
                                <div class="field">
                                    <div class="control">
                                        {{ form_widget(form.aiLevel) }}
                                    </div>
                                    {{ form_help(form.aiLevel) }}
                                    {{ form_errors(form.aiLevel) }}
                                </div>
                            </div>
                        </div>

                        <div class="field is-horizontal">
                            <div class="field-label"></div>
                            <div class="field-body">
                                <div class="field">
                                    <div class="control">
                                        {# The checkbox widget renders its own label (form/bulma_layout). #}
                                        {{ form_widget(form.liveEvaluation) }}
                                    </div>
                                    {{ form_help(form.liveEvaluation) }}
                                    {{ form_errors(form.liveEvaluation) }}
                                </div>
                            </div>
                        </div>

                        <div class="field is-grouped is-grouped-right">
                            <div class="control">
                                <a href="{{ path('lobby') }}" class="button is-rounded">{{ 'new_local_game.back'|trans }}</a>
                            </div>
                            <div class="control">
                                {{ form_widget(form.submit, {attr: {class: 'button is-rounded is-primary'}}) }}
                            </div>
                        </div>

                        {{ form_end(form) }}

                        {# Difficulty only applies against the AI. #}
                        <script>
                            (() => {
                                const opponent = document.getElementById('{{ form.opponentType.vars.id }}');
                                const level = document.getElementById('ai-level-field');
                                const hotseat = '{{ (form.opponentType.vars.choices|filter(c => c.data == enum('App\\Model\\OpponentType').HOTSEAT)|first).value }}';
                                const sync = () => { level.hidden = opponent.value === hotseat; };
                                opponent.addEventListener('change', sync);
                                sync();
                            })();
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
