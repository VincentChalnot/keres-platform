{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'new_local_game.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page container-page--narrow">
            <div class="card">
                <h1 class="page-title">{{ 'new_local_game.title'|trans }}</h1>
                <p class="page-subtitle">{{ 'new_local_game.subtitle.before'|trans }} <a href="{{ path('lobby') }}">{{ 'new_local_game.subtitle.link'|trans }}</a>{{ 'new_local_game.subtitle.after'|trans }}</p>

                {{ form_start(form) }}

                {% for name in ['playerSide', 'opponentType'] %}
                    <div class="field-row">
                        {{ form_label(form[name]) }}
                        <div>
                            {{ form_widget(form[name]) }}
                            {{ form_help(form[name]) }}
                            {{ form_errors(form[name]) }}
                        </div>
                    </div>
                {% endfor %}

                <div class="field-row" id="ai-level-field">
                    {{ form_label(form.aiLevel) }}
                    <div>
                        {{ form_widget(form.aiLevel) }}
                        {{ form_help(form.aiLevel) }}
                        {{ form_errors(form.aiLevel) }}
                    </div>
                </div>

                <div class="field-row">
                    <span class="max-md:hidden"></span>
                    <div>
                        {# The checkbox widget renders its own label (form/ds_layout). #}
                        {{ form_widget(form.liveEvaluation) }}
                        {{ form_help(form.liveEvaluation) }}
                        {{ form_errors(form.liveEvaluation) }}
                    </div>
                </div>

                <div class="btn-group btn-group--end">
                    <a href="{{ path('lobby') }}" class="btn btn--outline">{{ 'new_local_game.back'|trans }}</a>
                    {{ form_widget(form.submit) }}
                </div>

                {{ form_end(form) }}

                {# Difficulty only applies against the AI. #}
                <script>
                    (() => {
                        const opponent = document.getElementById('{{ form.opponentType.vars.id }}');
                        const level = document.getElementById('ai-level-field');
                        const hotseat = '{{ (form.opponentType.vars.choices|filter(c => c.data == enum('App\\Model\\OpponentType').HOTSEAT)|first).value }}';
                        const sync = () => { level.hidden = opponent.value === hotseat; };
                        opponent.addEventListener('change', sync);
                        sync();
                    })();
                </script>
            </div>
        </div>
    </section>
{% endblock %}
