{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'new_local_game.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page container-page--narrow">
            <div class="card">
                <h1 class="page-title">{{ 'new_local_game.title'|trans }}</h1>
                <p class="page-subtitle">{{ 'new_local_game.subtitle.before'|trans }} <a href="{{ path('lobby') }}">{{ 'new_local_game.subtitle.link'|trans }}</a>{{ 'new_local_game.subtitle.after'|trans }}</p>

                {{ form_start(form) }}

                {# This page is the custom game against the AI; the hot-seat game is a card of the lobby (_hotseat_card). #}
                <input type="hidden" name="{{ form.opponentType.vars.full_name }}" value="{{ (form.opponentType.vars.choices|filter(c => c.data == enum('App\\Model\\OpponentType').AI)|first).value }}">
                {% do form.opponentType.setRendered %}

                <div class="field-row">
                    {{ form_label(form.playerSide) }}
                    <div>
                        {% include 'actions/_choice_cards.html.twig' with {field: form.playerSide, kind: 'side'} only %}
                        {% do form.playerSide.setRendered %}
                        {{ form_help(form.playerSide) }}
                        {{ form_errors(form.playerSide) }}
                    </div>
                </div>

                <div class="field-row">
                    {{ form_label(form.aiLevel) }}
                    <div>
                        {% include 'actions/_choice_cards.html.twig' with {field: form.aiLevel, kind: 'level'} only %}
                        {% do form.aiLevel.setRendered %}
                        {{ form_help(form.aiLevel) }}
                        {{ form_errors(form.aiLevel) }}
                    </div>
                </div>

                <div class="field-row">
                    <span class="max-md:hidden"></span>
                    <div>
                        {# The checkbox widget renders its own label (form/ds_layout). #}
                        {{ form_widget(form.rated) }}
                        {{ form_help(form.rated) }}
                        {{ form_errors(form.rated) }}
                    </div>
                </div>

                <div class="field-row" id="ai-cadence-field">
                    {{ form_label(form.cadence) }}
                    <div>
                        {{ form_widget(form.cadence) }}
                        {{ form_errors(form.cadence) }}
                    </div>
                </div>

                <div class="field-row" id="ai-live-evaluation-field">
                    <span class="max-md:hidden"></span>
                    <div>
                        {{ form_widget(form.liveEvaluation) }}
                        {{ form_help(form.liveEvaluation) }}
                        {{ form_errors(form.liveEvaluation) }}
                    </div>
                </div>

                <div class="btn-group btn-group--end">
                    <a href="{{ path('lobby') }}" class="btn btn--outline">{{ 'new_local_game.back'|trans }}</a>
                    {{ form_widget(form.submit) }}
                </div>

                {{ form_end(form) }}

                {# A rated game has a clock and no evaluation bar. #}
                <script>
                    (() => {
                        const rated = document.getElementById('{{ form.rated.vars.id }}');
                        const sync = () => {
                            document.getElementById('ai-cadence-field').hidden = !rated.checked;
                            document.getElementById('ai-live-evaluation-field').hidden = rated.checked;
                        };
                        rated.addEventListener('change', sync);
                        sync();
                    })();
                </script>
            </div>
        </div>
    </section>
{% endblock %}
