{% extends 'base.html.twig' %}

{#
    Settings shell: vertical section nav on the left, one section per page.
    Each section template sets `section` (from its action) and fills `settings_content`.
#}
{% set settings_sections = [
    {key: 'profile', route: 'settings_profile', label: 'Profile', icon: 'fa-id-card'},
    {key: 'board', route: 'settings_board', label: 'Board & gameplay', icon: 'fa-chess-board'},
    {key: 'notifications', route: 'settings_notifications', label: 'Notifications', icon: 'fa-bell'},
    {key: 'privacy', route: 'settings_privacy', label: 'Privacy', icon: 'fa-user-shield'},
    {key: 'connections', route: 'settings_connections', label: 'Connected accounts', icon: 'fa-link'},
] %}

{% block title %}Settings{% endblock %}

{% block body %}
<main class="section">
    <div class="container">
        <h1 class="title">Settings</h1>
        <div class="columns settings">
            <div class="column is-3">
                <aside class="menu settings-nav" aria-label="Settings sections">
                    <ul class="menu-list">
                        {% for item in settings_sections %}
                            <li>
                                <a href="{{ path(item.route) }}"
                                   class="{{ item.key == section ? 'is-active' }}"
                                   {% if item.key == section %}aria-current="page"{% endif %}>
                                    <span class="icon"><i class="fa-solid {{ item.icon }}" aria-hidden="true"></i></span>
                                    <span>{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </aside>
            </div>
            <div class="column">
                {% block settings_content %}{% endblock %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
