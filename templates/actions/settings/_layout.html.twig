{% extends 'base.html.twig' %}
{% trans_default_domain 'settings' %}

{#
    Settings shell: vertical section nav on the left, one section per page.
    Each section template sets `section` (from its action) and fills `settings_content`.
#}
{% set settings_sections = [
    {key: 'profile', route: 'settings_profile', label: 'nav.profile'|trans, icon: 'fa-id-card'},
    {key: 'board', route: 'settings_board', label: 'nav.board'|trans, icon: 'fa-chess-board'},
    {key: 'notifications', route: 'settings_notifications', label: 'nav.notifications'|trans, icon: 'fa-bell'},
    {key: 'privacy', route: 'settings_privacy', label: 'nav.privacy'|trans, icon: 'fa-user-shield'},
    {key: 'connections', route: 'settings_connections', label: 'nav.connections'|trans, icon: 'fa-link'},
] %}

{% block title %}{{ 'title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container-page">
        <h1 class="page-title mb-6">{{ 'title'|trans }}</h1>
        <div class="grid gap-6 md:grid-cols-[14rem_minmax(0,1fr)]">
            <aside class="menu" aria-label="{{ 'nav.label'|trans }}">
                <ul class="menu__list">
                    {% for item in settings_sections %}
                        <li>
                            <a href="{{ path(item.route) }}"
                               class="menu__link{{ item.key == section ? ' is-active' }}"
                               {% if item.key == section %}aria-current="page"{% endif %}>
                                <span class="icon"><i class="fa-solid {{ item.icon }}" aria-hidden="true"></i></span>
                                <span>{{ item.label }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </aside>
            <div class="min-w-0">
                {% block settings_content %}{% endblock %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
