{% extends 'actions/settings/_layout.html.twig' %}

{% block title %}Connected accounts - Settings{% endblock %}

{% block settings_content %}
    <div class="box">
        <h2 class="title is-4">Connected accounts</h2>
        <p class="has-text-grey">The providers you can sign in with.</p>
        {% set providers = {google: 'fa-google', discord: 'fa-discord'} %}
        {% set linked = user.auths|map(auth => auth.provider) %}
        <ul class="settings-providers">
            {% for provider, icon in providers %}
                <li class="settings-providers__row">
                    <span class="icon"><i class="fa-brands {{ icon }}" aria-hidden="true"></i></span>
                    <span>{{ provider|capitalize }}</span>
                    {% if provider in linked %}
                        <span class="tag is-rounded is-primary ml-2">Linked</span>
                    {% else %}
                        <span class="tag is-rounded is-dark ml-2">Not linked</span>
                    {% endif %}
                </li>
            {% endfor %}
            {% for auth in user.auths|filter(auth => auth.provider not in providers|keys) %}
                <li class="settings-providers__row">
                    <span>{{ auth.provider|capitalize }}</span>
                    <span class="tag is-rounded is-primary ml-2">Linked</span>
                </li>
            {% endfor %}
        </ul>
        {% if user.password %}
            <p class="mt-3">You can also sign in with your email and password.</p>
        {% endif %}
        <p class="help mt-3">Signing in with another provider that uses the same email links it to this account automatically.</p>
    </div>
{% endblock %}
