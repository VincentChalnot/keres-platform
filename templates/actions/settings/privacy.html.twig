{% extends 'actions/settings/_layout.html.twig' %}
{% trans_default_domain 'settings' %}

{% block title %}{{ 'page_title'|trans({section: 'nav.privacy'|trans}) }}{% endblock %}

{% block settings_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'card'}}) }}
        <h2 class="card__title">{{ 'privacy.title'|trans }}</h2>

        {{ form_row(form.searchableByOtherUsers) }}
        {{ form_row(form.allowContactByEmail) }}

        <div class="mt-6">
            {{ form_widget(form.submit) }}
        </div>
    {{ form_end(form) }}

    <div class="card" id="settings-blocked-root">
        <h3 class="card__title card__title--sm">{{ 'privacy.blocked.title'|trans }}</h3>
        {% if blockedUsers|length > 0 %}
            <ul class="friend-list">
                {% for friendship in blockedUsers %}
                    {% set blocked = friendship.getOther(user) %}
                    <li class="friend-row">
                        <a href="{{ path('profile', {username: blocked.username}) }}">{{ blocked.displayName ?? blocked.username }}</a>
                        <button type="button" class="btn btn--outline btn--sm"
                                data-action="friend-unblock" data-username="{{ blocked.username }}">{{ 'privacy.blocked.unblock'|trans }}</button>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted mb-0">{{ 'privacy.blocked.empty'|trans }}</p>
        {% endif %}
    </div>

    <div class="card">
        <h3 class="card__title card__title--sm">{{ 'privacy.data.title'|trans }}</h3>
        <p class="text-muted mb-4">
            {{ 'privacy.data.intro'|trans }}
        </p>

        {{ form_start(dataExportForm, {attr: {novalidate: 'novalidate', class: 'mb-6'}}) }}
            <h4 class="eyebrow">{{ 'privacy.data.export_title'|trans }}</h4>
            {{ form_row(dataExportForm.email) }}
            {{ form_row(dataExportForm.message) }}
            {{ form_widget(dataExportForm.submit) }}
        {{ form_end(dataExportForm) }}

        {{ form_start(accountDeletionForm, {attr: {novalidate: 'novalidate'}}) }}
            <h4 class="eyebrow">{{ 'privacy.data.deletion_title'|trans }}</h4>
            {{ form_row(accountDeletionForm.email) }}
            {{ form_row(accountDeletionForm.message) }}
            {{ form_widget(accountDeletionForm.submit, {attr: {class: 'btn--danger-soft h-auto max-w-full whitespace-normal justify-center py-2 text-center'}}) }}
        {{ form_end(accountDeletionForm) }}
    </div>

{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
