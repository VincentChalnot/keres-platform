{% extends 'actions/settings/_layout.html.twig' %}

{% block title %}Privacy - Settings{% endblock %}

{% block settings_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'box'}}) }}
        <h2 class="title is-4">Privacy</h2>

        {{ form_row(form.searchableByOtherUsers) }}
        {{ form_row(form.allowContactByEmail) }}

        <div class="field mt-5">
            <div class="control">
                {{ form_widget(form.submit, {attr: {class: 'button is-primary is-rounded'}}) }}
            </div>
        </div>
    {{ form_end(form) }}

    <div class="box" id="settings-blocked-root">
        <h3 class="title is-5">Blocked users</h3>
        {% if blockedUsers|length > 0 %}
            <ul class="friends-list">
                {% for friendship in blockedUsers %}
                    {% set blocked = friendship.getOther(user) %}
                    <li class="friends-list__row mb-2">
                        <a href="{{ path('profile', {username: blocked.username}) }}">{{ blocked.displayName ?? blocked.username }}</a>
                        <button type="button" class="button is-small is-rounded is-outlined is-light ml-2"
                                data-action="friend-unblock" data-username="{{ blocked.username }}">Unblock</button>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="has-text-grey">You haven't blocked anyone. You can block a player from their profile page.</p>
        {% endif %}
    </div>

    <div class="box">
        <h3 class="title is-5">Your data</h3>
        <p class="has-text-grey mb-4">
            Request a copy of your data, or request that your account be deleted. Both are handled
            by a person, not automatically — we'll get back to you within 30 days.
        </p>

        {{ form_start(dataExportForm, {attr: {novalidate: 'novalidate', class: 'mb-5'}}) }}
            <h4 class="title is-6">Export my data</h4>
            {{ form_row(dataExportForm.email) }}
            {{ form_row(dataExportForm.message) }}
            {{ form_widget(dataExportForm.submit, {attr: {class: 'button is-rounded'}}) }}
        {{ form_end(dataExportForm) }}

        {{ form_start(accountDeletionForm, {attr: {novalidate: 'novalidate'}}) }}
            <h4 class="title is-6">Delete my account</h4>
            {{ form_row(accountDeletionForm.email) }}
            {{ form_row(accountDeletionForm.message) }}
            {{ form_widget(accountDeletionForm.submit, {attr: {class: 'button is-rounded is-danger is-outlined'}}) }}
        {{ form_end(accountDeletionForm) }}
    </div>

{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
