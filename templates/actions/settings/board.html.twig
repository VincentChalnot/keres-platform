{% extends 'actions/settings/_layout.html.twig' %}
{% trans_default_domain 'settings' %}

{% block title %}{{ 'page_title'|trans({section: 'nav.board'|trans}) }}{% endblock %}

{% block settings_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'card'}}) }}
        <h2 class="card__title">{{ 'board.title'|trans }}</h2>
        <p class="text-muted">{{ 'board.intro'|trans }}</p>

        {{ form_row(form.showBoardCoordinates) }}
        {{ form_row(form.showOpponentThreatsOnHover) }}
        {{ form_row(form.rotateOpponentPieces) }}
        {{ form_row(form.pieceAnimationSpeed) }}
        {{ form_row(form.coach) }}
        {{ form_row(form.chessExperience) }}

        <div class="mt-6">
            {{ form_widget(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
