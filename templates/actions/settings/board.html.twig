{% extends 'actions/settings/_layout.html.twig' %}
{% trans_default_domain 'settings' %}

{% block title %}{{ 'page_title'|trans({section: 'nav.board'|trans}) }}{% endblock %}

{% block settings_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'box'}}) }}
        <h2 class="title is-4">{{ 'board.title'|trans }}</h2>
        <p class="has-text-grey">{{ 'board.intro'|trans }}</p>

        {{ form_row(form.showBoardCoordinates) }}
        {{ form_row(form.showOpponentThreatsOnHover) }}

        <div class="field mt-5">
            <div class="control">
                {{ form_widget(form.submit, {attr: {class: 'button is-primary is-rounded'}}) }}
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
