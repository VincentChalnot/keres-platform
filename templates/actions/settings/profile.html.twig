{% extends 'actions/settings/_layout.html.twig' %}
{% trans_default_domain 'settings' %}

{% block title %}{{ 'page_title'|trans({section: 'nav.profile'|trans}) }}{% endblock %}

{% block settings_content %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'card'}}) }}
        <h2 class="card__title">{{ 'profile.title'|trans }}</h2>
        {{ form_errors(form) }}

        <div class="field">
            {{ form_label(form.username) }}
            {{ form_widget(form.username) }}
            {% if canChangeUsername %}
                <p class="help">{{ 'profile.username_can_change'|trans({date: 'now'|date_modify('+12 months')|format_date('long')}) }}</p>
            {% else %}
                <p class="help">{{ 'profile.username_locked'|trans({date: nextUsernameChangeAt|format_date('long')}) }}</p>
            {% endif %}
            {{ form_errors(form.username) }}
        </div>

        <div class="field">
            {{ form_label(form.displayName) }}
            {{ form_widget(form.displayName) }}
            <p class="help">{{ 'profile.display_name_help'|trans }}</p>
            {{ form_errors(form.displayName) }}
        </div>

        <div class="grid grid-cols-1 gap-x-4 md:grid-cols-2">
            <div class="field">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName) }}
                {{ form_errors(form.firstName) }}
            </div>
            <div class="field">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName) }}
                {{ form_errors(form.lastName) }}
            </div>
        </div>

        <div class="field">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            <p class="help">{{ 'profile.email_help'|trans }}</p>
        </div>

        <div class="grid grid-cols-1 gap-x-4 md:grid-cols-2">
            <div class="field">
                {{ form_label(form.locale) }}
                {{ form_widget(form.locale) }}
                <p class="help">{{ 'profile_settings.locale_help'|trans({}, 'forms') }}</p>
                {{ form_errors(form.locale) }}
            </div>
            <div class="field">
                {{ form_label(form.country) }}
                {{ form_widget(form.country) }}
                {{ form_errors(form.country) }}
            </div>
        </div>

        <div class="mt-6">
            {{ form_widget(form.submit) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
