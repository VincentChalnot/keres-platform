{# The feedback form, shared by /feedback (inside a card) and the game page modal (fetched over XHR, see FeedbackAction): no wrapper of its own. #}
{% trans_default_domain 'pages' %}
{% if sent %}
    <div class="alert alert--success">
        <strong>{{ 'feedback.thanks'|trans }}</strong> {{ 'feedback.thanks_detail'|trans }}
    </div>
{% else %}
    {{ form_start(form, {attr: {novalidate: 'novalidate', id: 'feedback-form'}}) }}
        {{ form_row(form.category) }}
        {{ form_row(form.message) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}
{% endif %}
