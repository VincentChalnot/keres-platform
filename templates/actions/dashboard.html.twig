{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'dashboard.page_title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container">
        <h1 class="title">{{ app.user.displayName ? 'dashboard.welcome_named'|trans({name: app.user.displayName}) : 'dashboard.welcome'|trans }}</h1>

        <div class="columns is-multiline dashboard-widgets">
            <div class="column is-half">
                {% include 'actions/dashboard/_recent_games.html.twig' %}
            </div>
            <div class="column is-half">
                {% include 'actions/dashboard/_stats.html.twig' %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
