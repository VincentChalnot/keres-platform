{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'dashboard.page_title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container-page">
        <h1 class="page-title mb-6">{{ app.user.displayName ? 'dashboard.welcome_named'|trans({name: app.user.displayName}) : 'dashboard.welcome'|trans }}</h1>

        <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[1fr_22rem] [&>.card]:!mb-0">
            {% include 'actions/dashboard/_recent_games.html.twig' %}
            {% include 'actions/dashboard/_stats.html.twig' %}
        </div>
    </div>
</main>
{% endblock %}
