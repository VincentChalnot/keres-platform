{% extends 'base.html.twig' %}
{% trans_default_domain 'game' %}

{% block title %}{{ 'invite.page_title'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="box">
                        {% if state == 'self_invite' %}
                            <h3 class="title">{{ 'invite.self.title'|trans }}</h3>
                            <p class="subtitle">{{ 'invite.self.text'|trans }}</p>
                        {% elseif state == 'blocked' %}
                            <h3 class="title">{{ 'invite.blocked.title'|trans }}</h3>
                            <p class="subtitle">{{ 'invite.blocked.text'|trans }}</p>
                        {% elseif state == 'rate_limited' %}
                            <h3 class="title">{{ 'invite.rate_limited.title'|trans }}</h3>
                            <p class="subtitle">{{ 'invite.rate_limited.text'|trans }}</p>
                        {% elseif state == 'expired' %}
                            <h3 class="title">{{ 'invite.expired.title'|trans }}</h3>
                            <p class="subtitle">{{ 'invite.expired.text'|trans }}</p>
                        {% else %}
                            <h3 class="title">{{ 'invite.not_found.title'|trans }}</h3>
                            <p class="subtitle">{{ 'invite.not_found.text'|trans }}</p>
                        {% endif %}

                        <p class="mt-3">
                            <a href="{{ path('lobby') }}">{{ 'invite.back_to_lobby'|trans }}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
