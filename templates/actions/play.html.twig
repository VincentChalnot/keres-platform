{% extends 'base.html.twig' %}

{% block title %}Play Game - Keres{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="mercure-url" content="{{ mercure(url('play', {uuid: game.uuid})) }}">
{% endblock %}

{% block body %}
    {% include 'actions/_play_board.html.twig' with {
        opponentType: game.opponentType.value,
        gameUuid: game.uuid,
        spectator: not game.isParticipant(app.user),
        guest: false,
        isAi: game.opponentType == enum('App\\Model\\OpponentType').AI,
        gameOver: game.gameOver,
    } %}
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('play') }}
{% endblock %}
