{# T13: the one games-list row markup, fed a `GameListRow` (see
   `App\Model\GameListRow`, built by `game_list_row()`). Used by the
   dashboard widget, `/games`, the lobby and a profile's game history - never
   duplicated. The players and option badges are the game page's own header
   partial, compact. @var row \App\Model\GameListRow #}
{% trans_default_domain 'game' %}
<div class="card list-row">
    <div class="list-row__body">
        {% include 'actions/_game_header.html.twig' with {header: row.header, compact: true} only %}
        <p class="list-row__meta">
            {% if row.turnLabel %}
                <span class="tag {{ row.isSubjectTurn ? 'tag--primary' : 'tag--brand' }}">{{ row.turnLabel }}</span>
            {% endif %}
            {% if row.resultLabel %}
                <span class="tag tag--light">{{ row.resultLabel }}</span>
            {% endif %}
            {% if row.timeRemainingLabel %}
                <span>{{ row.timeRemainingLabel }}</span>
            {% endif %}
            {% set activityDate = row.lastActivityAt|format_datetime('medium', 'short') %}
            <span>{{ row.isGameOver ? 'game_row.finished'|trans({date: activityDate}) : 'game_row.last_move'|trans({date: activityDate}) }}</span>
        </p>
    </div>
    <a href="{{ path('play', {uuid: row.uuid}) }}" class="btn btn--primary btn--sm list-row__action">
        {{ row.isGameOver ? 'game_row.action.view'|trans : (isSelf ? 'game_row.action.resume'|trans : 'game_row.action.watch'|trans) }}
    </a>
</div>
