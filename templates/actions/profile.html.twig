{% extends 'base.html.twig' %}
{% trans_default_domain 'social' %}

{% block title %}{{ subject.displayName ?? subject.username }} (@{{ subject.username }}){% endblock %}

{% block body %}
    <section class="section">
        <div class="container-page">
            <div id="profile-root" data-username="{{ subject.username }}" data-is-self="{{ isSelf ? 'true' : 'false' }}">
                <div class="card">
                    <div class="flex flex-wrap items-center gap-4">
                        {% if subject.avatarUrl %}
                            <img class="avatar avatar--lg" src="{{ subject.avatarUrl }}" alt="">
                        {% else %}
                            <i class="fa-solid fa-circle-user text-6xl leading-none text-muted" aria-hidden="true"></i>
                        {% endif %}
                        <div class="min-w-[12rem] flex-1">
                            <h1 class="page-title !mb-0 !text-3xl break-words">
                                {{ subject.displayName ?? subject.username }}
                                {% if online %}
                                    <span class="tag tag--soft tag--success ml-2 align-middle">{{ 'profile.online'|trans }}</span>
                                {% endif %}
                            </h1>
                            <p class="mb-0 text-muted">
                                @{{ subject.username }} &middot; {{ 'profile.member_since'|trans({date: subject.createdAt|format_date(pattern: 'LLLL y')}) }}
                            </p>
                        </div>
                        <div class="btn-group">
                            {% if isSelf %}
                                <a href="{{ path('settings_profile') }}" class="btn btn--outline btn--sm">{{ 'profile.edit'|trans }}</a>
                            {% endif %}

                            {% if not isSelf and relationship is not null %}
                                {% if relationship.value == 'none' %}
                                    <button type="button" class="btn btn--primary btn--sm" data-action="friend-request">{{ 'profile.action.add_friend'|trans }}</button>
                                {% elseif relationship.value == 'pending_out' %}
                                    <span class="tag tag--light">{{ 'profile.action.request_sent'|trans }}</span>
                                {% elseif relationship.value == 'pending_in' %}
                                    <button type="button" class="btn btn--primary btn--sm" data-action="friend-accept">{{ 'profile.action.accept'|trans }}</button>
                                    <button type="button" class="btn btn--outline btn--sm" data-action="friend-decline">{{ 'profile.action.decline'|trans }}</button>
                                {% elseif relationship.value == 'friends' %}
                                    <button type="button" class="btn btn--outline btn--sm" data-action="friend-remove">{{ 'profile.action.unfriend'|trans }}</button>
                                {% endif %}

                                {% if relationship.value == 'blocked_by_me' %}
                                    <button type="button" class="btn btn--outline btn--sm" data-action="friend-unblock">{{ 'profile.action.unblock'|trans }}</button>
                                {% else %}
                                    <button type="button" class="btn btn--danger-soft btn--sm" data-action="friend-block">{{ 'profile.action.block'|trans }}</button>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="card !mb-0">
                        <h2 class="card__title">{{ 'profile.ratings.title'|trans }}</h2>
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                <tr>
                                    <th>{{ 'profile.ratings.category'|trans }}</th>
                                    <th>{{ 'profile.ratings.rating'|trans }}</th>
                                    <th>{{ 'profile.ratings.games'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for category, rating in ratings %}
                                    <tr>
                                        <td>{{ ('profile.ratings.categories.' ~ category)|trans }}</td>
                                        <td class="{{ rating.provisional ? 'text-muted' : '' }}">
                                            {{ rating.rating|format_number }}{% if rating.provisional %}<span title="{{ 'profile.ratings.provisional_hint'|trans }}">?</span>{% endif %}
                                        </td>
                                        <td>{{ rating.games|format_number }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card !mb-0">
                        <h2 class="card__title">{{ 'profile.record.title'|trans }}</h2>
                        <div class="stat-row">
                            <div class="stat">
                                <p class="stat__label">{{ 'profile.record.wins'|trans }}</p>
                                <p class="stat__value">{{ stats.wins|format_number }}</p>
                            </div>
                            <div class="stat">
                                <p class="stat__label">{{ 'profile.record.losses'|trans }}</p>
                                <p class="stat__value">{{ stats.losses|format_number }}</p>
                            </div>
                            <div class="stat">
                                <p class="stat__label">{{ 'profile.record.draws'|trans }}</p>
                                <p class="stat__value">{{ stats.draws|format_number }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <h2 class="mb-4 mt-8 font-title text-2xl">{{ 'profile.games.title'|trans }}</h2>

                {% for game in games %}
                    {# @var game \App\Entity\Game #}
                    {% include 'actions/_game_row.html.twig' with {row: game_list_row(game, subject, isSelf, app.user), isSelf: isSelf} %}
                {% else %}
                    <p class="text-muted">{{ (isSelf ? 'profile.games.empty_self' : 'profile.games.empty_other')|trans }}</p>
                {% endfor %}

                {% if games.haveToPaginate %}
                    <nav class="pagination" aria-label="{{ 'profile.pagination.label'|trans }}">
                        {% if games.hasPreviousPage %}
                            <a class="pagination__prev" href="{{ path('profile', {username: subject.username, page: games.previousPage}) }}">{{ 'profile.pagination.previous'|trans }}</a>
                        {% else %}
                            <span class="pagination__prev is-disabled" aria-disabled="true">{{ 'profile.pagination.previous'|trans }}</span>
                        {% endif %}
                        <span class="pagination__list">{{ 'profile.pagination.page_of'|trans({page: games.currentPage, total: games.nbPages}) }}</span>
                        {% if games.hasNextPage %}
                            <a class="pagination__next" href="{{ path('profile', {username: subject.username, page: games.nextPage}) }}">{{ 'profile.pagination.next'|trans }}</a>
                        {% else %}
                            <span class="pagination__next is-disabled" aria-disabled="true">{{ 'profile.pagination.next'|trans }}</span>
                        {% endif %}
                    </nav>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
