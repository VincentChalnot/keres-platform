{% extends 'base.html.twig' %}
{% trans_default_domain 'social' %}

{% block title %}{{ subject.displayName ?? subject.username }} (@{{ subject.username }}){% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div id="profile-root" data-username="{{ subject.username }}" data-is-self="{{ isSelf ? 'true' : 'false' }}">
                <div class="box">
                    <div class="columns is-vcentered">
                        <div class="column is-narrow">
                            {% if subject.avatarUrl %}
                                <figure class="image is-64x64">
                                    <img class="is-rounded" src="{{ subject.avatarUrl }}" alt="">
                                </figure>
                            {% else %}
                                <span class="icon is-large">
                                    <i class="fa-solid fa-circle-user fa-3x" aria-hidden="true"></i>
                                </span>
                            {% endif %}
                        </div>
                        <div class="column">
                            <h1 class="title mb-1">
                                {{ subject.displayName ?? subject.username }}
                                {% if online %}
                                    <span class="tag is-success is-rounded ml-2">{{ 'profile.online'|trans }}</span>
                                {% endif %}
                            </h1>
                            <p class="subtitle is-6 has-text-grey">
                                @{{ subject.username }} &middot; {{ 'profile.member_since'|trans({date: subject.createdAt|format_date(pattern: 'LLLL y')}) }}
                            </p>
                        </div>
                        <div class="column is-narrow buttons">
                            {% if isSelf %}
                                <a href="{{ path('settings_profile') }}" class="button is-rounded is-light">{{ 'profile.edit'|trans }}</a>
                            {% endif %}

                            {% if not isSelf and relationship is not null %}
                                {% if relationship.value == 'none' %}
                                    <button type="button" class="button is-rounded is-primary" data-action="friend-request">{{ 'profile.action.add_friend'|trans }}</button>
                                {% elseif relationship.value == 'pending_out' %}
                                    <span class="tag is-light is-rounded">{{ 'profile.action.request_sent'|trans }}</span>
                                {% elseif relationship.value == 'pending_in' %}
                                    <button type="button" class="button is-rounded is-primary" data-action="friend-accept">{{ 'profile.action.accept'|trans }}</button>
                                    <button type="button" class="button is-rounded is-light" data-action="friend-decline">{{ 'profile.action.decline'|trans }}</button>
                                {% elseif relationship.value == 'friends' %}
                                    <button type="button" class="button is-rounded is-light" data-action="friend-remove">{{ 'profile.action.unfriend'|trans }}</button>
                                {% endif %}

                                {% if relationship.value == 'blocked_by_me' %}
                                    <button type="button" class="button is-rounded is-light" data-action="friend-unblock">{{ 'profile.action.unblock'|trans }}</button>
                                {% else %}
                                    <button type="button" class="button is-rounded is-danger is-light" data-action="friend-block">{{ 'profile.action.block'|trans }}</button>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="columns is-multiline">
                    <div class="column is-half">
                        <div class="box">
                            <h3 class="title is-5">{{ 'profile.ratings.title'|trans }}</h3>
                            <table class="table is-fullwidth">
                                <thead>
                                <tr>
                                    <th>{{ 'profile.ratings.category'|trans }}</th>
                                    <th>{{ 'profile.ratings.rating'|trans }}</th>
                                    <th>{{ 'profile.ratings.games'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for category, rating in ratings %}
                                    <tr>
                                        <td>{{ ('profile.ratings.categories.' ~ category)|trans }}</td>
                                        <td class="{{ rating.provisional ? 'has-text-grey' : '' }}">
                                            {{ rating.rating|format_number }}{% if rating.provisional %}<span title="{{ 'profile.ratings.provisional_hint'|trans }}">?</span>{% endif %}
                                        </td>
                                        <td>{{ rating.games|format_number }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="column is-half">
                        <div class="box">
                            <h3 class="title is-5">{{ 'profile.record.title'|trans }}</h3>
                            <div class="level is-mobile">
                                <div class="level-item has-text-centered">
                                    <div>
                                        <p class="heading">{{ 'profile.record.wins'|trans }}</p>
                                        <p class="title">{{ stats.wins|format_number }}</p>
                                    </div>
                                </div>
                                <div class="level-item has-text-centered">
                                    <div>
                                        <p class="heading">{{ 'profile.record.losses'|trans }}</p>
                                        <p class="title">{{ stats.losses|format_number }}</p>
                                    </div>
                                </div>
                                <div class="level-item has-text-centered">
                                    <div>
                                        <p class="heading">{{ 'profile.record.draws'|trans }}</p>
                                        <p class="title">{{ stats.draws|format_number }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h2 class="title is-4">{{ 'profile.games.title'|trans }}</h2>

                {% for game in games %}
                    {# @var game \App\Entity\Game #}
                    {% include 'actions/_game_row.html.twig' with {row: game_list_row(game, subject, isSelf, app.user), isSelf: isSelf} %}
                {% else %}
                    <p class="has-text-grey">{{ (isSelf ? 'profile.games.empty_self' : 'profile.games.empty_other')|trans }}</p>
                {% endfor %}

                {% if games.haveToPaginate %}
                    <nav class="pagination" role="navigation" aria-label="{{ 'profile.pagination.label'|trans }}">
                        {% if games.hasPreviousPage %}
                            <a class="pagination-previous" href="{{ path('profile', {username: subject.username, page: games.previousPage}) }}">{{ 'profile.pagination.previous'|trans }}</a>
                        {% else %}
                            <a class="pagination-previous" disabled>{{ 'profile.pagination.previous'|trans }}</a>
                        {% endif %}
                        {% if games.hasNextPage %}
                            <a class="pagination-next" href="{{ path('profile', {username: subject.username, page: games.nextPage}) }}">{{ 'profile.pagination.next'|trans }}</a>
                        {% else %}
                            <a class="pagination-next" disabled>{{ 'profile.pagination.next'|trans }}</a>
                        {% endif %}
                        <span class="pagination-list ml-3">{{ 'profile.pagination.page_of'|trans({page: games.currentPage, total: games.nbPages}) }}</span>
                    </nav>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}

{% block end_javascripts %}
    {{ vite_entry_script_tags('lobby') }}
{% endblock %}
