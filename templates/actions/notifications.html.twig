{% extends 'base.html.twig' %}
{% trans_default_domain 'notifications' %}

{% block title %}{{ 'page.title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container-page">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <h1 class="page-title !mb-0">{{ 'page.title'|trans }}</h1>
            {% if unread > 0 %}
                <button type="button" class="btn btn--outline btn--sm" data-notifications-read-all>{{ 'page.mark_all_read'|trans }}</button>
            {% endif %}
        </div>

        <div class="card card--flush">
            {% if notifications|length > 0 %}
                <ul class="notif-list" id="notification-page-list">
                    {% for n in notifications %}
                        <li class="notif{{ n.read ? '' : ' is-unread' }}" data-uuid="{{ n.uuid }}">
                            <a href="{{ n.url }}" class="notif__link items-baseline" data-notification-link>
                                <span class="icon"><i class="fa-solid {{ n.icon }}" aria-hidden="true"></i></span>
                                <span class="notif__text">{{ n.text }}</span>
                                <time class="notif__time" datetime="{{ n.createdAt }}">{{ n.createdAt|format_datetime('medium', 'short') }}</time>
                            </a>
                            {% if not n.read %}
                                <button type="button" class="btn btn--text btn--sm notif__action" data-notification-read title="{{ 'page.mark_read'|trans }}" aria-label="{{ 'page.mark_read'|trans }}">
                                    <span class="icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                </button>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="notif-empty">{{ 'page.empty'|trans }}</p>
            {% endif %}
        </div>

        {% if pages > 1 %}
            <nav class="pagination" aria-label="{{ 'page.pagination.label'|trans }}">
                {% if page > 1 %}
                    <a class="pagination__prev" href="{{ path('notifications', {page: page - 1}) }}">{{ 'page.pagination.previous'|trans }}</a>
                {% else %}
                    <span class="pagination__prev is-disabled" aria-disabled="true">{{ 'page.pagination.previous'|trans }}</span>
                {% endif %}
                <span class="pagination__list">{{ 'page.pagination.page_of'|trans({page: page, total: pages}) }}</span>
                {% if page < pages %}
                    <a class="pagination__next" href="{{ path('notifications', {page: page + 1}) }}">{{ 'page.pagination.next'|trans }}</a>
                {% else %}
                    <span class="pagination__next is-disabled" aria-disabled="true">{{ 'page.pagination.next'|trans }}</span>
                {% endif %}
            </nav>
        {% endif %}
        <p class="mt-4"><a href="{{ path('settings_notifications') }}">{{ 'page.preferences_link'|trans }}</a></p>
    </div>
</main>
{% endblock %}
