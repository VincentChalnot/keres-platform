{% extends 'base.html.twig' %}
{% trans_default_domain 'notifications' %}

{% block title %}{{ 'page.title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container">
        <div class="level">
            <div class="level-left">
                <h1 class="title">{{ 'page.title'|trans }}</h1>
            </div>
            <div class="level-right">
                {% if unread > 0 %}
                    <button type="button" class="button is-rounded is-outlined is-light" data-notifications-read-all>{{ 'page.mark_all_read'|trans }}</button>
                {% endif %}
            </div>
        </div>

        <div class="box">
            {% if notifications|length > 0 %}
                <ul class="notification-list" id="notification-page-list">
                    {% for n in notifications %}
                        <li class="notification-list__item{{ n.read ? '' : ' is-unread' }}" data-uuid="{{ n.uuid }}">
                            <a href="{{ n.url }}" class="notification-list__link" data-notification-link>
                                <span class="icon"><i class="fa-solid {{ n.icon }}" aria-hidden="true"></i></span>
                                <span class="notification-list__text">{{ n.text }}</span>
                                <time class="notification-list__time" datetime="{{ n.createdAt }}">{{ n.createdAt|format_datetime('medium', 'short') }}</time>
                            </a>
                            {% if not n.read %}
                                <button type="button" class="button is-small is-text" data-notification-read title="{{ 'page.mark_read'|trans }}" aria-label="{{ 'page.mark_read'|trans }}">
                                    <span class="icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                                </button>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="has-text-grey">{{ 'page.empty'|trans }}</p>
            {% endif %}
        </div>

        {% if pages > 1 %}
            <nav class="pagination" role="navigation" aria-label="{{ 'page.pagination.label'|trans }}">
                {% if page > 1 %}
                    <a class="pagination-previous" href="{{ path('notifications', {page: page - 1}) }}">{{ 'page.pagination.previous'|trans }}</a>
                {% endif %}
                {% if page < pages %}
                    <a class="pagination-next" href="{{ path('notifications', {page: page + 1}) }}">{{ 'page.pagination.next'|trans }}</a>
                {% endif %}
                <span class="pagination-list ml-3">{{ 'page.pagination.page_of'|trans({page: page, total: pages}) }}</span>
            </nav>
        {% endif %}
        <p class="mt-4"><a href="{{ path('settings_notifications') }}">{{ 'page.preferences_link'|trans }}</a></p>
    </div>
</main>
{% endblock %}
