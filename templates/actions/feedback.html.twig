{% extends 'base.html.twig' %}
{% trans_default_domain 'pages' %}

{% block title %}{{ 'feedback.page_title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container-page container-page--narrow">
        <h1 class="page-title">{{ 'feedback.title'|trans }}</h1>
        <p class="page-subtitle">{{ 'feedback.subtitle'|trans }}</p>

        {% if sent %}
            {% include 'actions/_feedback_form.html.twig' with {form: form, sent: sent} %}
        {% else %}
            <div class="card">
                {% include 'actions/_feedback_form.html.twig' with {form: form, sent: sent} %}
            </div>
        {% endif %}
    </div>
</main>
{% endblock %}
