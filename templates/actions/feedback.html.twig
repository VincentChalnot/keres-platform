{% extends 'base.html.twig' %}

{% block title %}Feedback{% endblock %}

{% block body %}
<main class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-7">
                <h1 class="title">Alpha Feedback</h1>
