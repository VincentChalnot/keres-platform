{% extends 'base.html.twig' %}
{% trans_default_domain 'pages' %}

{% block title %}{{ 'feedback.page_title'|trans }}{% endblock %}

{% block body %}
<main class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-7">
                <h1 class="title">{{ 'feedback.title'|trans }}</h1>
                <p class="subtitle">{{ 'feedback.subtitle'|trans }}</p>

                {% include 'actions/_feedback_form.html.twig' with {form: form, sent: sent} %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
