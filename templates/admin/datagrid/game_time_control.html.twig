{% set tc = result.game.timeControl %}
{% if tc.kind.name == 'REALTIME' %}
    {{ (tc.initialSeconds // 60) }}+{{ tc.incrementSeconds }}{% if tc.initialSeconds % 60 %} <span class="text-muted">({{ tc.initialSeconds }}s)</span>{% endif %}
{% elseif tc.kind.name == 'CORRESPONDENCE' %}
    {{ tc.hoursPerMove }}h / move
{% else %}
    <span class="text-muted">Unlimited</span>
{% endif %}
