{% set game = result.game %}
{% set reason = game.endReason.name %}
{% if not game.gameOver %}
    <span class="tag tag--soft tag--info">{{ result.movesCount > 0 ? 'In progress' : 'Not started' }}</span>
{% elseif reason == 'ABORTED' %}
    <span class="tag">Aborted</span>
{% else %}
    {% if game.draw %}
        <span class="tag">½-½</span>
    {% elseif game.whiteWins %}
        <span class="tag tag--soft tag--success">1-0</span>
    {% else %}
        <span class="tag tag--soft tag--success">0-1</span>
    {% endif %}
    <span class="text-muted text-xs">{{ {NONE: '', ENGINE: 'engine', RESIGNATION: 'resignation', TIMEOUT: 'timeout', ABANDONMENT: 'abandonment', DRAW_AGREED: 'draw agreed'}[reason]|default('') }}</span>
{% endif %}
