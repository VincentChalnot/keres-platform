{% macro side(userId, username, aiLevel) %}
    {% if userId %}
        <a href="{{ admin_path('User', 'read', {id: userId}) }}">{{ username }}</a>
    {% else %}
        <span class="text-muted">Engine{{ aiLevel ? ' L' ~ aiLevel : '' }}</span>
    {% endif %}
{% endmacro %}
{% import _self as m %}
{% set game = result.game %}
<span class="inline-flex items-center gap-1.5 whitespace-nowrap">
    <span class="tag tag--white">W</span>
    {{ m.side(result.whiteUserId, result.whiteUsername, game.aiLevel) }}
    <span class="text-subtle">vs</span>
    <span class="tag tag--brand">B</span>
    {{ m.side(result.blackUserId, result.blackUsername, game.aiLevel) }}
</span>
