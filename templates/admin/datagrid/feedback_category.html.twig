{% set category = column.renderValue(result) %}
{% set categoryColors = {
    bug: 'danger',
    suggestion: 'info',
    gameplay: 'primary',
    other: 'light',
    contact: 'warning',
    data_export_request: 'link',
    account_deletion_request: 'dark',
    waitlist: 'success',
} %}
<span class="tag is-{{ categoryColors[category]|default('light') }}">
    {{ category }}
</span>
