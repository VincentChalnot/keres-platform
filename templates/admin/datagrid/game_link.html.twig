{% set game = result.game %}
<a href="{{ path('play', {uuid: game.uuid}) }}" class="font-semibold" title="{{ game.uuid }}" target="_blank" rel="noopener">{{ game.id }}</a>
{% if game.deletedAt %}
    <span class="tag tag--soft tag--danger" title="Deleted by a player on {{ game.deletedAt|date('Y-m-d H:i') }}">Deleted</span>
{% endif %}
