{% extends 'admin/base.html.twig' %}

{% block admin_title %}User — {{ user.email }}{% endblock %}

{% block container %}
    <h1 class="page-title">{{ user.displayName ?? user.email }}</h1>
    <p class="page-subtitle">{{ user.email }} — joined {{ user.createdAt|date('Y-m-d H:i') }}</p>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5 mb-2">
        <div class="card stat !mb-0">
            <p class="stat__label">Games</p>
            <p class="stat__value">{{ stats.gamesCount }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Wins</p>
            <p class="stat__value text-success">{{ stats.winCount }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Losses</p>
            <p class="stat__value text-danger-text">{{ stats.loseCount }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Draws</p>
            <p class="stat__value">{{ stats.drawCount }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Last move</p>
            <p class="stat__value !text-xl">{{ stats.lastMoveAt ? stats.lastMoveAt|date('Y-m-d H:i') : '—' }}</p>
        </div>
    </div>

    <h2 class="card__title mt-8">Games</h2>
    <div class="table-wrap">
        <table class="table table--hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Opponent</th>
                    <th>Result</th>
                    <th>Moves</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                {% for game in games %}
                    <tr>
                        <td>{{ game.id }}</td>
                        <td>{{ game.opponentType.name|capitalize }}</td>
                        <td>
                            {% if not game.gameOver %}
                                <span class="tag tag--soft tag--info">In progress</span>
                            {% elseif game.draw %}
                                <span class="tag">Draw</span>
                            {% elseif game.whiteWins == (game.creatorColor.name == 'WHITE') %}
                                <span class="tag tag--soft tag--success">Win</span>
                            {% else %}
                                <span class="tag tag--soft tag--danger">Loss</span>
                            {% endif %}
                        </td>
                        <td>{{ game.gameMoves|length }}</td>
                        <td>{{ game.createdAt|date('Y-m-d H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="empty">No games yet</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ admin_path('User', 'list') }}" class="btn btn--outline mt-4">
        &larr; Back to users
    </a>
{% endblock %}
