{% extends 'admin/base.html.twig' %}

{% block admin_title %}Opening Explorer{% endblock %}

{% block container %}
    <h1 class="page-title">Opening Explorer</h1>
    <p class="page-subtitle">Most-played openings, up to 4 plies from the shared starting position.</p>

    {% if rootPositionId is null %}
        <div class="alert alert--warning">
            No games have been played yet — nothing to explore.
        </div>
    {% else %}
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
            <div class="card !mb-0">
                <h3 class="card__title card__title--sm">Opening tree</h3>
                <div
                    id="opening-tree"
                    data-root-position-id="{{ rootPositionId }}"
                    data-root-position-data="{{ rootPositionData }}"
                >
                    <p class="text-muted">Loading…</p>
                </div>
            </div>
            <div class="card !mb-0">
                <h3 class="card__title card__title--sm">Debug board</h3>
                <div id="opening-debug-board"></div>
                <p id="opening-eval" class="mt-3 text-muted"></p>
                <div id="opening-stats" class="mt-4"></div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('admin') }}
{% endblock %}
