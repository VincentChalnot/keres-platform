{% extends 'base.html.twig' %}

{% block title %}Admin — {% block admin_title %}Panel{% endblock %}{% endblock %}

{% block body %}
    {# Side menu: the entry whose path prefixes the current one is highlighted (src/components/navigation.css `.menu`). #}
    {% set current_path = app.request.pathInfo %}
    {% set admin_menu = [
        {path: path('admin_dashboard'), icon: 'fa-gauge', label: 'Dashboard', exact: true},
        {path: admin_path('Feedback', 'list'), icon: 'fa-comment-dots', label: 'Feedback'},
        {path: admin_path('User', 'list'), icon: 'fa-users', label: 'Users'},
        {path: admin_path('Game', 'list'), icon: 'fa-chess-pawn', label: 'Games'},
        {path: admin_path('MailerError', 'list'), icon: 'fa-envelope-circle-check', label: 'Mailer errors'},
        {path: path('admin_opening_explorer'), icon: 'fa-chess-board', label: 'Opening explorer'},
        {path: path('admin_bot_tournament'), icon: 'fa-robot', label: 'Bot tournament'},
        {path: path('admin_board_editor'), icon: 'fa-pen-ruler', label: 'Board editor'},
    ] %}
    <section class="section">
        <div class="container-page container-page--fluid">
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-[14rem_minmax(0,1fr)]">
                <aside class="menu">
                    <p class="menu__label">Admin</p>
                    <ul class="menu__list">
                        {% for item in admin_menu %}
                            {% set active = item.exact|default(false) ? current_path|trim('/') == 'admin' : current_path starts with item.path %}
                            <li>
                                <a href="{{ item.path }}" class="menu__link{{ active ? ' is-active' }}"{% if active %} aria-current="page"{% endif %}>
                                    <span class="icon"><i class="fa-solid {{ item.icon }}" aria-hidden="true"></i></span>
                                    <span>{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </aside>
                <div>
                    {% block container %}{% endblock %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
