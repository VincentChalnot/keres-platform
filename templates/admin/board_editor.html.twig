{% extends 'admin/base.html.twig' %}

{% block admin_title %}Board editor{% endblock %}

{% block container %}
    <h2 class="title is-4">Board editor</h2>
    <p class="subtitle is-6">
        Build a position from scratch on the game's own board, draw arrows on it and export it as static HTML.
        Nothing is stored: the board code (also kept in the URL hash) is the position.
    </p>

    <div class="columns" id="board-editor">
        <div class="column is-7">
            <div class="board-editor__board" id="board-editor-board"></div>
        </div>

        <div class="column">
            <div class="box">
                <h3 class="title is-6">Pieces</h3>
                <div class="board-editor__palette" id="board-editor-palette" role="group" aria-label="Piece palette"></div>

                <div class="field mt-4">
                    <label class="label is-small" id="board-editor-placement-label">Placing on a square</label>
                    <div class="buttons has-addons mb-0" role="group" aria-labelledby="board-editor-placement-label">
                        <button type="button" class="button is-small is-link" data-placement="replace" aria-pressed="true">Replace what is there</button>
                        <button type="button" class="button is-small" data-placement="stack" aria-pressed="false">Stack on top of the piece there</button>
                    </div>
                </div>

                <p class="help">
                    Click a square to place the selected piece (or to empty it with the eraser) and drag a piece to move it to another square.
                    A stack is a bottom piece plus a top piece of the same colour: place the bottom piece, then switch to "Stack on top" and place the top one.
                    Right-drag between two squares draws an arrow (Shift: green, Ctrl: red; the same arrow again removes it).
                </p>
                <p class="help is-danger" id="board-editor-status" role="status"></p>
            </div>

            <div class="box">
                <h3 class="title is-6">Position</h3>
                <div class="buttons">
                    <button type="button" class="button is-small" id="board-editor-clear">Clear board</button>
                    <button type="button" class="button is-small" id="board-editor-start">Starting position</button>
                    <button type="button" class="button is-small" id="board-editor-flip">Flip board</button>
                    <button type="button" class="button is-small" id="board-editor-undo" disabled>Undo</button>
                    <button type="button" class="button is-small" id="board-editor-redo" disabled>Redo</button>
                </div>
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" id="board-editor-coordinates" checked>
                        Show coordinates
                    </label>
                </div>
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" id="board-editor-rotate">
                        Rotate opponent pieces
                    </label>
                </div>
                <p class="help">Coordinates, rotation and orientation apply to the board exactly as in a game, and to the export.</p>
            </div>

            <div class="box">
                <h3 class="title is-6">Board code</h3>
                <div class="field">
                    <div class="control">
                        <textarea class="textarea is-family-monospace is-small has-fixed-size" id="board-editor-code" rows="3" spellcheck="false" autocomplete="off" aria-label="Board code"></textarea>
                    </div>
                    <p class="help is-danger" id="board-editor-code-error" role="alert"></p>
                </div>
                <div class="buttons">
                    <button type="button" class="button is-small" id="board-editor-copy">Copy</button>
                </div>
                <p class="help">Paste a code in the field to load that position. Arrows are not part of the code; White is to move, no-capture counter 0.</p>
            </div>

            <div class="box">
                <h3 class="title is-6">Arrows and export</h3>
                <div class="buttons">
                    <button type="button" class="button is-small" id="board-editor-clear-arrows">Clear arrows</button>
                    <button type="button" class="button is-small is-primary" id="board-editor-export">Export HTML</button>
                </div>
                <p class="help">The export is the board exactly as shown here: position, arrows, orientation, coordinates and piece rotation.</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('admin') }}
{% endblock %}
