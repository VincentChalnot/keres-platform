{% extends 'admin/base.html.twig' %}

{% block admin_title %}Board editor{% endblock %}

{% block container %}
    <h1 class="page-title">Board editor</h1>
    <p class="page-subtitle">
        Build a position from scratch on the game's own board, draw arrows on it and export it as static HTML.
        Nothing is stored: the board code (also kept in the URL hash) is the position.
    </p>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]" id="board-editor">
        <div class="board-editor__board" id="board-editor-board"></div>

        <div class="min-w-0">
            <div class="card">
                <h3 class="card__title card__title--sm">Pieces</h3>
                <div id="board-editor-palette" role="group" aria-label="Piece palette"></div>

                <div class="field mt-4">
                    <p class="label !text-sm" id="board-editor-placement-label">Placing on a square</p>
                    <div class="btn-group" role="group" aria-labelledby="board-editor-placement-label">
                        <button type="button" class="btn btn--outline btn--sm" data-placement="replace" aria-pressed="true">Replace what is there</button>
                        <button type="button" class="btn btn--outline btn--sm" data-placement="stack" aria-pressed="false">Stack on top of the piece there</button>
                    </div>
                </div>

                <p class="help">
                    Click a square to place the selected piece (or to empty it with the eraser) and drag a piece to move it to another square.
                    A stack is a bottom piece plus a top piece of the same colour: place the bottom piece, then switch to "Stack on top" and place the top one.
                    Right-drag between two squares draws an arrow (Shift: green, Ctrl: red; the same arrow again removes it).
                </p>
                <p class="help help--danger" id="board-editor-status" role="status"></p>
            </div>

            <div class="card">
                <h3 class="card__title card__title--sm">Position</h3>
                <div class="btn-group mb-4">
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-clear">Clear board</button>
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-start">Starting position</button>
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-flip">Flip board</button>
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-undo" disabled>Undo</button>
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-redo" disabled>Redo</button>
                </div>
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" id="board-editor-coordinates" checked>
                        Show coordinates
                    </label>
                </div>
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" id="board-editor-rotate">
                        Rotate opponent pieces
                    </label>
                </div>
                <p class="help">Coordinates, rotation and orientation apply to the board exactly as in a game, and to the export.</p>
            </div>

            <div class="card">
                <h3 class="card__title card__title--sm">Board code</h3>
                <div class="field">
                    <textarea class="textarea font-mono text-sm resize-none" id="board-editor-code" rows="3" spellcheck="false" autocomplete="off" aria-label="Board code"></textarea>
                    <p class="help help--danger" id="board-editor-code-error" role="alert"></p>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-copy">Copy</button>
                </div>
                <p class="help">Paste a code in the field to load that position. Arrows are not part of the code; White is to move, no-capture counter 0.</p>
            </div>

            <div class="card !mb-0">
                <h3 class="card__title card__title--sm">Arrows and export</h3>
                <div class="btn-group">
                    <button type="button" class="btn btn--outline btn--sm" id="board-editor-clear-arrows">Clear arrows</button>
                    <button type="button" class="btn btn--primary btn--sm" id="board-editor-export">Export HTML</button>
                    <button type="button" class="btn btn--primary btn--sm" id="board-editor-export-svg">Export SVG</button>
                </div>
                <p class="help">The export is the board exactly as shown here: position, arrows, orientation, coordinates and piece rotation.</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('admin') }}
{% endblock %}
