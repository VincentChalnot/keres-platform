{% extends 'admin/base.html.twig' %}

{% block admin_title %}Dashboard{% endblock %}

{% block container %}
    <h1 class="page-title mb-6">Dashboard</h1>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-2">
        <div class="card stat !mb-0">
            <p class="stat__label">Total players</p>
            <p class="stat__value">{{ totalPlayers }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Connected (last 5 min)</p>
            <p class="stat__value">{{ connectedPlayers }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Finished games</p>
            <p class="stat__value">{{ outcomes.win + outcomes.lose + outcomes.draw }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Stale games (24h+)</p>
            <p class="stat__value{{ staleGames|length > 0 ? ' stat__value--warning' }}">{{ staleGames|length }}</p>
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        <div class="card !mb-0">
            <h3 class="card__title card__title--sm">Game outcome distribution</h3>
            <div class="mx-auto max-w-xs"><canvas id="admin-outcome-chart" height="200"></canvas></div>
        </div>
        <div class="card !mb-0">
            <h3 class="card__title card__title--sm">Move-count distribution</h3>
            <canvas id="admin-move-count-chart" height="200"></canvas>
        </div>
    </div>

    <h2 class="card__title mt-8">Stale games</h2>
    <div class="table-wrap">
        <table class="table table--hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Owner</th>
                    <th>Opponent</th>
                    <th>Moves</th>
                    <th>Created</th>
                    <th>Last activity</th>
                </tr>
            </thead>
            <tbody>
                {% for game in staleGames %}
                    <tr>
                        <td>{{ game.id }}</td>
                        <td>{{ game.createdBy.email }}</td>
                        <td>{{ game.opponentType.name|capitalize }}</td>
                        <td>{{ game.gameMoves|length }}</td>
                        <td>{{ game.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ (game.lastMoveAt ?? game.createdAt)|date('Y-m-d H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty">No stale games</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <script type="application/json" id="admin-stats">
        {{ {outcomes: outcomes, moveCountDistribution: moveCountDistribution}|json_encode|raw }}
    </script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('admin') }}
{% endblock %}
