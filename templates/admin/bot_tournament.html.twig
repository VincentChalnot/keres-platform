{% extends 'admin/base.html.twig' %}

{% block admin_title %}Bot tournament{% endblock %}

{% block container %}
    <h1 class="page-title mb-6">Bot tournament</h1>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-6">
        <div class="card stat !mb-0">
            <p class="stat__label">Queued (incl. running)</p>
            <p class="stat__value">{{ report.queued ?? 'n/a' }}</p>
        </div>
        <div class="card stat !mb-0">
            <p class="stat__label">Games in progress</p>
            <p class="stat__value">{{ report.ongoing }}</p>
        </div>
    </div>

    {% if report.standings is empty %}
        <div class="alert alert--info text-center">
            No bot accounts yet. Run <code>bin/console app:bot-tournament</code> to queue a tournament.
        </div>
    {% else %}
        <h2 class="card__title">Standings</h2>
        <div class="table-wrap mb-8">
            <table class="table table--hover">
                <thead>
                    <tr>
                        <th>Level</th>
                        <th>Games</th>
                        <th>W</th>
                        <th>D</th>
                        <th>L</th>
                        <th>Score</th>
                        {% for category in report.categories %}
                            <th>Glicko-2 ({{ category }})</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in report.standings %}
                        <tr>
                            <td>L{{ row.level }}</td>
                            <td>{{ row.games }}</td>
                            <td>{{ row.wins }}</td>
                            <td>{{ row.draws }}</td>
                            <td>{{ row.losses }}</td>
                            <td>{{ row.score is null ? '-' : row.score|number_format(1) ~ '%' }}</td>
                            {% for category in report.categories %}
                                {% set rating = row.ratings[category] ?? null %}
                                <td>{{ rating is null ? '-' : rating.rating ~ ' ± ' ~ rating.deviation }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <h2 class="card__title">Head-to-head</h2>
        <p class="text-muted">Row's score % against column (games played)</p>
        <div class="table-wrap">
            <table class="table table--hover">
                <thead>
                    <tr>
                        <th>vs</th>
                        {% for opp in report.levels %}
                            <th>L{{ opp }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for me in report.levels %}
                        <tr>
                            <th>L{{ me }}</th>
                            {% for opp in report.levels %}
                                {% set cell = report.matrix[me][opp] ?? null %}
                                <td>
                                    {%- if me == opp -%}
                                        ·
                                    {%- elseif cell is null -%}
                                        -
                                    {%- else -%}
                                        {{ (100 * cell.score / cell.games)|number_format(0) }}% ({{ cell.games }})
                                    {%- endif -%}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
